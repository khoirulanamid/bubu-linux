    def draw_visualizer_bars(self, cr, cx, cy, num_bars, is_playing, color, max_h=18.0, bar_w=2.0, bar_gap=2.2, alpha=1.0):
        cr.save()
        cr.translate(cx, cy)
        total_w = num_bars * bar_w + (num_bars - 1) * bar_gap
        start_x = -total_w / 2.0

        for i in range(num_bars):
            if is_playing:
                phase = self.visualizer_phase + i * 1.35
                h_norm = 0.45 * math.sin(phase) + 0.30 * math.sin(phase * 1.7 + 0.5) + 0.55
                bh = 3.5 + (max_h - 3.5) * max(0.0, min(1.0, h_norm))
            else:
                bh = 2.5

            bx = start_x + i * (bar_w + bar_gap)
            by = -bh / 2.0
            r = bar_w / 2.0

            cr.new_path()
            cr.new_sub_path()
            cr.arc(bx + r, by + r, r, math.pi, 0)
            cr.arc(bx + r, by + bh - r, r, 0, math.pi)
            cr.close_path()

            cr.set_source_rgba(color[0], color[1], color[2], alpha * 0.80)
            cr.fill()

        cr.restore()

    # ─── Geometric Cairo Vector Playback Controls ───────────────────
    def draw_vector_play_pause(self, cr, cx, cy, r, is_playing, alpha=1.0):
        cr.save()
        # Solid Pure Off-White Circle (Apple / Hardware style - Zero gradients)
        cr.new_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgba(0.96, 0.97, 0.99, alpha * 0.96)
        cr.fill()

        # Vector Icon (Solid Dark Charcoal)
        cr.translate(cx, cy)
        cr.set_source_rgba(0.08, 0.09, 0.11, alpha * 0.96)

        if is_playing:
            # Two rounded vertical pause bars
            pw, ph, pr = r * 0.16, r * 0.58, r * 0.08
            spacing = r * 0.36
            for bx in [-spacing / 2.0 - pw / 2.0, spacing / 2.0 - pw / 2.0]:
                cr.new_sub_path()
                cr.arc(bx + pr, -ph / 2.0 + pr, pr, math.pi, 0)
                cr.arc(bx + pr, ph / 2.0 - pr, pr, 0, math.pi)
                cr.close_path()
                cr.fill()
        else:
            # Equilateral play triangle pointing right
            tw = r * 0.42
            cr.new_path()
            cr.move_to(-tw * 0.5 + 1.0, -tw * 0.72)
            cr.line_to(tw + 1.0, 0)
            cr.line_to(-tw * 0.5 + 1.0, tw * 0.72)
            cr.close_path()
            cr.fill()

        cr.restore()

