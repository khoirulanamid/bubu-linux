def format_duration(seconds):
    if seconds <= 0:
        return "00:00"
    m = seconds // 60
    s = seconds % 60
    if m >= 60:
        h = m // 60
        m = m % 60
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

# ─── Universal AI Agent Client ──────────────────────────────────────
def parse_llm_response(raw_text, is_anthropic_direct=False):
    raw_text = raw_text.strip()
    # 1. Try standard JSON first
    if raw_text.startswith("{") and raw_text.endswith("}"):
        try:
            data = json.loads(raw_text)
            if is_anthropic_direct:
                if "content" in data and isinstance(data["content"], list):
                    return data["content"][0].get("text", "")
            if "choices" in data and len(data["choices"]) > 0:
                choice = data["choices"][0]
                if "message" in choice and "content" in choice["message"]:
                    return choice["message"]["content"]
                if "text" in choice:
                    return choice["text"]
            if "content" in data and isinstance(data["content"], list):
                return data["content"][0].get("text", "")
            if "error" in data:
                err = data["error"]
                return f"Error API: {err.get('message', str(err))}"
        except Exception:
            pass

    # 2. If SSE stream (starts with 'data:' or contains 'data: ')
    collected = []
    lines = raw_text.splitlines()
    for line in lines:
        line = line.strip()
        if not line or line == "data: [DONE]":
            continue
        if line.startswith("data:"):
            chunk_str = line[5:].strip()
            try:
                chunk = json.loads(chunk_str)
                if "choices" in chunk and len(chunk["choices"]) > 0:
                    delta = chunk["choices"][0].get("delta", {})
                    content = delta.get("content", "")
                    if content:
                        collected.append(content)
            except Exception:
                continue
    if collected:
        return "".join(collected)

    try:
        data = json.loads(raw_text)
        return str(data)
    except Exception:
        return raw_text

def call_ai_api(base_url, api_key, model, messages, max_tokens=1024):
    base_url = (base_url or "https://openrouter.ai/api/v1").rstrip("/")
    is_anthropic_direct = "anthropic.com" in base_url
    ctx = ssl.create_default_context()

    if is_anthropic_direct:
        url = f"{base_url}/messages" if not base_url.endswith("/messages") else base_url
        headers = {
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "Content-Type": "application/json"
        }
        system_msg = ""
        clean_msgs = []
        for m in messages:
            if m.get("role") == "system":
                system_msg = m.get("content", "")
            else:
                clean_msgs.append({"role": m.get("role", "user"), "content": m.get("content", "")})

        payload = {
            "model": model or "claude-3-5-sonnet-20241022",
            "max_tokens": max_tokens,
            "messages": clean_msgs
        }
        if system_msg:
            payload["system"] = system_msg

    else: # OpenAI / OpenRouter / DeepSeek / Ollama / Local Proxy
        url = f"{base_url}/chat/completions" if not base_url.endswith("/chat/completions") else base_url
        headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        }
        payload = {
            "model": model or "gpt-4o-mini",
            "messages": messages,
            "max_tokens": max_tokens,
            "temperature": 0.7,
            "stream": False
        }

    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST"
    )

    with urllib.request.urlopen(req, timeout=40, context=ctx) as resp:
        raw_text = resp.read().decode("utf-8")

    return parse_llm_response(raw_text, is_anthropic_direct)

