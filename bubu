    # ─── Content Click Interactions ─────────────────────────────────
    def on_button_press(self, widget, event):
        self.last_interaction_time = time.time()
        if self.mascot_state == "SLEEPY":
            self.mascot_state = "AWAKE"

        if not self.is_expanded:
            self.expand()
            return True

        x, y = event.x, event.y
        p = max(0.0, self.spring.val)
        cur_w = self.IDLE_W + p * (self.EXP_W - self.IDLE_W)
        px = (self.EXP_W - cur_w) / 2.0

        # Clicking top header area (Y <= 34) toggles retract
        if y <= 34:
            self.retract()
            return True

        # 1. Tab Navigation (Y = 36 to 64)
        if 36 <= y <= 64:
            bar_x = px + 20
            bar_w = cur_w - 40
            tab_w = bar_w / len(self.tabs)
            for i in range(len(self.tabs)):
                tx = bar_x + i * tab_w
                if tx <= x <= tx + tab_w:
                    self.active_tab = i
                    self.update_widget_visibility()
                    self.queue_draw()
                    return True

        # 2. Content Interactions
        if self.active_tab == 0: # Music
            cx = self.EXP_W / 2.0

            # 2a. Floating Mini Player Toggle Switch (Top-Right): X: cur_w - 95 .. cur_w - 20, Y: 74 .. 100
            if px + cur_w - 95 <= x <= px + cur_w - 20 and 74 <= y <= 100:
                is_on = not self.settings.get("floating_player_enabled", True)
                self.settings["floating_player_enabled"] = is_on
                save_settings(self.settings)
                if is_on:
                    self.floating_player.show_all()
                else:
                    self.floating_player.hide()
                self.queue_draw()
                return True

            # 2b. Scrubber Seek: Y: 132 .. 152, X: px + 24 .. px + cur_w - 24
            bar_x = px + 24
            bar_w = cur_w - 48
            if 132 <= y <= 152 and bar_x <= x <= bar_x + bar_w:
                if self.active_player and self.active_player.get('length', 0) > 0:
                    pct = max(0.0, min(1.0, (x - bar_x) / bar_w))
                    target_sec = int(pct * self.active_player['length'])
                    self.mpris.set_position(self.active_player, target_sec)
                    self.active_player['position'] = target_sec
                    self.queue_draw()
                return True

            # 2c. Playback Controls at Y=182
            btn_cy = 182
            if btn_cy - 24 <= y <= btn_cy + 24:
                # Prev Button (cx - 52, r=16)
                if cx - 70 <= x <= cx - 34:
                    self.mpris.previous(self.active_player)
                    return True
                # Play/Pause Button (cx, r=20)
                elif cx - 24 <= x <= cx + 24:
                    self.mpris.play_pause(self.active_player)
                    return True
                # Next Button (cx + 52, r=16)
                elif cx + 34 <= x <= cx + 70:
                    self.mpris.next(self.active_player)
                    return True

        elif self.active_tab == 1: # Agent AI
            # 2a. Settings Gear ⚙ Click
            if px + cur_w - 46 <= x <= px + cur_w - 20 and 70 <= y <= 94:
                self.open_ai_settings_dialog()
                return True

            # 2b. Reset / Clear Chat 🗑 Click
            if px + cur_w - 74 <= x <= px + cur_w - 48 and 70 <= y <= 94:
                self.ai_messages = []
                save_chat(self.ai_messages)
                self.rebuild_chat_ui()
                self.queue_draw()
                return True

            # 2c. Send Button ➤ Click
            if px + cur_w - 54 <= x <= px + cur_w - 18 and 190 <= y <= 228:
                self.on_send_chat()
                return True

        elif self.active_tab == 2: # Focus
            btn_y = 166
            cx = self.EXP_W / 2.0
            if btn_y - 18 <= y <= btn_y + 18:
                if cx - 95 <= x <= cx - 10:
                    self.pomo_running = not self.pomo_running
                    self.queue_draw()
                    return True
                elif cx + 10 <= x <= cx + 95:
                    self.pomo_running = False
                    self.pomo_time_left = self.settings.get("pomodoro_duration", 25 * 60)
                    self.queue_draw()
                    return True

        elif self.active_tab == 3: # Shelf
            if px + cur_w - 90 <= x <= px + cur_w - 20 and 80 <= y <= 106:
                self.shelf_items = []
                save_shelf(self.shelf_items)
                self.queue_draw()
                return True

            item_y = 112
            for item in self.shelf_items[-3:]:
                if px + 20 <= x <= px + cur_w - 20 and item_y <= y <= item_y + 28:
                    subprocess.Popen(["xdg-open", item["path"]])
                    return True
                item_y += 30

        return True

    def open_ai_settings_dialog(self):
        def _on_save(new_settings):
            self.settings.update(new_settings)
            save_settings(self.settings)
            self.queue_draw()

        dialog = AISettingsDialog(self.settings, _on_save)
        dialog.show_all()

    def on_send_chat(self):
        text = self.chat_entry.get_text().strip()
        if not text:
            return
        if self.ai_loading:
            return

        self.chat_entry.set_text("")
        self.ai_messages.append({"role": "user", "content": text})
        save_chat(self.ai_messages)
        self.rebuild_chat_ui()

        api_key = self.settings.get("ai_api_key", "").strip()
        base_url = self.settings.get("ai_base_url", "https://openrouter.ai/api/v1").strip()
        model = self.settings.get("ai_model", "anthropic/claude-3.5-sonnet").strip()

        if not api_key and not ("localhost" in base_url or "127.0.0.1" in base_url):
            self.ai_messages.append({
                "role": "assistant",
                "content": "⚠️ API Key belum disetel. Klik tombol ⚙ di kanan atas untuk mengatur Base URL & API Key."
            })
            save_chat(self.ai_messages)
            self.rebuild_chat_ui()
            self.queue_draw()
            return

        self.ai_loading = True
        self.rebuild_chat_ui()
        self.queue_draw()

        def _worker():
            try:
                system_prompt = self.settings.get("ai_system_prompt", "Kamu adalah asisten AI Bubu yang cerdas, ringkas, dan ramah di desktop Linux.")
                msgs_to_send = [{"role": "system", "content": system_prompt}] + self.ai_messages[-6:]
                reply = call_ai_api(base_url, api_key, model, msgs_to_send)
                GLib.idle_add(self._on_ai_reply, reply)
            except Exception as e:
                err_text = str(e)
                GLib.idle_add(self._on_ai_reply, f"⚠️ Gagal: {err_text}")

        threading.Thread(target=_worker, daemon=True).start()

    def _on_ai_reply(self, reply):
        self.ai_loading = False
        self.ai_messages.append({"role": "assistant", "content": reply})
        save_chat(self.ai_messages)
        self.rebuild_chat_ui()
        self.queue_draw()
        if not self.is_expanded:
            preview = reply[:120] + "..." if len(reply) > 120 else reply
            subprocess.Popen([
                "notify-send", "-a", "Bubu AI", "Bubu AI Agent", preview
            ], env=dict(os.environ, DISPLAY=":0", XAUTHORITY=os.path.expanduser("~/.Xauthority")))

    # ─── Cairo Render Pipeline ──────────────────────────────────────
    def on_draw(self, widget, cr):
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        if not self.is_expanded and self.spring.val == 0.0:
            # IDLE: Exactly fills the 166x30 window
            px = 0.0
            py = 0.0
            cur_w = float(self.IDLE_W)
            cur_h = float(self.IDLE_H)
            cur_r = 15.0

            self.draw_capsule_shape(cr, px, py, cur_w, cur_h, cur_r, 0.0)
            self.draw_idle_elements(cr, cur_w / 2.0, cur_h / 2.0, 1.0)
        else:
            # EXPANDING / EXPANDED: Canvas is 430x224
            p = max(0.0, self.spring.val)
            cur_w = self.IDLE_W + p * (self.EXP_W - self.IDLE_W)
            cur_h = self.IDLE_H + p * (self.EXP_H - self.IDLE_H)
            cur_r = 15.0 + min(1.0, p) * 11.0
            px = (self.EXP_W - cur_w) / 2.0
            py = 0.0

            self.draw_capsule_shape(cr, px, py, cur_w, cur_h, cur_r, p)

            # Layered transition
            idle_alpha = max(0.0, 1.0 - p * 3.0)
            if idle_alpha > 0.01:
                cr.save()
                self.draw_idle_elements(cr, self.EXP_W / 2.0, cur_h / 2.0, idle_alpha)
                cr.restore()

            exp_alpha = max(0.0, min(1.0, (p - 0.25) / 0.75))
            if exp_alpha > 0.01:
                slide_y = (1.0 - exp_alpha) * 8.0
                cr.save()
                cr.translate(0, -slide_y)
                self.draw_expanded_elements(cr, px, py, cur_w, cur_h, exp_alpha)
                cr.restore()

        return False

    def draw_capsule_shape(self, cr, px, py, w, h, r, p):
        cr.new_path()
        cr.new_sub_path()
        cr.move_to(px, 0)
        cr.line_to(px + w, 0)
        cr.line_to(px + w, h - r)
        cr.arc(px + w - r, h - r, r, 0, math.pi / 2)
        cr.line_to(px + r, h)
        cr.arc(px + r, h - r, r, math.pi / 2, math.pi)
        cr.close_path()

        # Solid Matte Obsidian Surface (No gradients, blends with laptop bezel)
        cr.set_source_rgba(0.05, 0.05, 0.06, 0.98) # #0d0d0f
        cr.fill_preserve()

        # Precision 1px Hairline Hardware Seam
        border_alpha = 0.16 if (self.is_hovered and not self.is_expanded) else 0.09
        cr.set_source_rgba(1.0, 1.0, 1.0, border_alpha)
        cr.set_line_width(1.0)
        cr.stroke()

    def draw_idle_elements(self, cr, cx, cy, alpha):
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        is_music_playing = (self.active_player and self.active_player.get('status') == 'Playing')

        # 1. When Music is Playing: Top Notch shows the CUTE SINGING MASCOT!
        if is_music_playing:
            source = self.detect_source(self.active_player)

            # Cute Singing Mascot in Center!
            self.draw_singing_mascot(cr, cx, cy, alpha)

            # Mini 3-bar animated visualizer on Right
            self.draw_visualizer_bars(cr, cx + 56, cy, num_bars=3, is_playing=True, color=[1.0, 1.0, 1.0], max_h=10.0, bar_w=2.0, bar_gap=2.0, alpha=alpha * 0.75)
            return

        # 2. Pomodoro Active
        if self.pomo_running:
            mins = self.pomo_time_left // 60
            secs = self.pomo_time_left % 60
            font = Pango.FontDescription("Ubuntu, Monospace Bold 8")
            layout.set_font_description(font)
            layout.set_text(f"{mins:02d}:{secs:02d}", -1)
            lw, lh = layout.get_pixel_size()
            cr.set_source_rgba(0.95, 0.40, 0.40, alpha * 0.90)
            cr.move_to(cx - 62, cy - lh / 2.0)
            PangoCairo.show_layout(cr, layout)

        # 3. Mascot ALWAYS in Center of Idle Pill!
        if self.is_hovered and not self.is_expanded:
            prev = self.mascot_state
            self.mascot_state = "HAPPY"
            self.draw_mascot_eyes(cr, cx, cy, alpha)
            self.mascot_state = prev
        else:
            self.draw_mascot_eyes(cr, cx, cy, alpha)

    def draw_singing_mascot(self, cr, cx, cy, alpha=1.0):
        spacing = 9.5
        rx = 3.2

        cr.save()
        cr.new_path()

        # Happy Singing Eyes ^ ^
        cr.set_source_rgba(0.92, 0.94, 0.98, alpha)
        cr.set_line_width(1.6)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)

        cr.new_sub_path()
        cr.arc(cx - spacing, cy - 2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
        cr.stroke()

        cr.new_sub_path()
        cr.arc(cx + spacing, cy - 2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
        cr.stroke()

        # Cute Singing Mouth o ↔ O bobbing with music
        mouth_scale = 1.0 + 0.5 * math.sin(self.visualizer_phase * 2.0)
        cr.new_sub_path()
        cr.save()
        cr.translate(cx, cy + 4.5)
        cr.scale(1.0, mouth_scale)
        cr.arc(0, 0, 2.2, 0, 2 * math.pi)
        cr.restore()
        cr.set_source_rgba(0.95, 0.45, 0.55, alpha * 0.90)
        cr.fill()

        # Floating Musical Note ♪
        layout = PangoCairo.create_layout(cr)
        font = Pango.FontDescription("Ubuntu, Sans Bold 8")
        layout.set_font_description(font)
        note = "♫" if int(self.visualizer_phase) % 2 == 0 else "♪"
        layout.set_text(note, -1)
        cr.set_source_rgba(0.70, 0.85, 1.0, alpha * 0.85)
        note_bob = 1.8 * math.sin(self.visualizer_phase)
        cr.move_to(cx + spacing + 6, cy - 8 + note_bob)
        PangoCairo.show_layout(cr, layout)

        cr.restore()

    def draw_mascot_eyes(self, cr, cx, cy, alpha=1.0):
        spacing = 11.0
        rx = 3.4
        ry = rx * max(0.12, 1.0 - self.blink_progress)

        cr.save()
        cr.new_path()

        if self.mascot_state == "AWAKE" or self.mascot_state == "BLINK":
            for ex in [cx - spacing, cx + spacing]:
                cr.save()
                # 1. White Eye Sclera (rounded pill, shrinks vertically during blink)
                cr.save()
                cr.translate(ex, cy)
                cr.scale(rx, ry)
                cr.arc(0, 0, 1.0, 0, 2 * math.pi)
                cr.restore()
                cr.set_source_rgba(0.94, 0.96, 0.99, alpha)
                cr.fill_preserve()
                cr.clip() # Ensure pupil stays strictly inside eye boundary

                # 2. Pupil looking in gaze direction (gaze_x, gaze_y)
                if self.blink_progress < 0.40:
                    px = ex + self.gaze_x
                    py = cy + self.gaze_y
                    cr.arc(px, py, 1.6, 0, 2 * math.pi)
                    cr.set_source_rgba(0.06, 0.07, 0.09, alpha * 0.98)
                    cr.fill()

                    # 3. Catchlight Sparkle (twinkle shine reflection)
                    cr.arc(px - 0.55, py - 0.55, 0.55, 0, 2 * math.pi)
                    cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.95)
                    cr.fill()

                cr.restore()

        elif self.mascot_state == "HAPPY":
            cr.set_source_rgba(0.92, 0.94, 0.98, alpha)
            cr.set_line_width(1.8)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.new_sub_path()
            cr.arc(cx - spacing, cy + 1.2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
            cr.stroke()
            cr.new_sub_path()
            cr.arc(cx + spacing, cy + 1.2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
            cr.stroke()

        elif self.mascot_state == "SLEEPY":
            cr.set_source_rgba(0.65, 0.68, 0.75, alpha * 0.85)
            cr.set_line_width(1.6)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.new_sub_path()
            cr.arc(cx - spacing, cy - 0.5, rx, 0.35, math.pi - 0.35)
            cr.stroke()
            cr.new_sub_path()
            cr.arc(cx + spacing, cy - 0.5, rx, 0.35, math.pi - 0.35)
            cr.stroke()

            cr.new_path()
            layout = PangoCairo.create_layout(cr)
            font = Pango.FontDescription("Ubuntu, Sans 8")
            layout.set_font_description(font)
            layout.set_text("z", -1)
            cr.move_to(cx + spacing + 7, cy - 3 - self.sleepy_z)
            cr.set_source_rgba(0.65, 0.68, 0.75, alpha * 0.85)
            PangoCairo.show_layout(cr, layout)

        cr.restore()

    def draw_expanded_elements(self, cr, px, py, w, h, alpha):
        cx = self.EXP_W / 2.0

        # Mascot top center
        self.draw_mascot_eyes(cr, cx, 16.0, alpha)

        # Close / Collapse Indicator on Top Right (at px + w - 24, 16)
        cr.save()
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription("Ubuntu, Sans Bold 8"))
        layout.set_text("✕", -1)
        cw, ch = layout.get_pixel_size()
        cr.set_source_rgba(0.50, 0.53, 0.60, alpha * 0.75)
        cr.move_to(px + w - 24 - cw / 2.0, 16 - ch / 2.0)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

        # Segmented Control Tab Bar (Apple / macOS style)
        bar_x = px + 20
        bar_y = 36.0
        bar_w = w - 40
        bar_h = 26.0
        bar_r = 7.0

        # Unified container
        cr.new_sub_path()
        cr.arc(bar_x + bar_w - bar_r, bar_y + bar_r, bar_r, -math.pi/2, 0)
        cr.arc(bar_x + bar_w - bar_r, bar_y + bar_h - bar_r, bar_r, 0, math.pi/2)
        cr.arc(bar_x + bar_r, bar_y + bar_h - bar_r, bar_r, math.pi/2, math.pi)
        cr.arc(bar_x + bar_r, bar_y + bar_r, bar_r, math.pi, 3*math.pi/2)
        cr.close_path()
        cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.04)
        cr.fill()

        tab_w = bar_w / len(self.tabs)
        for i, title in enumerate(self.tabs):
            tx = bar_x + i * tab_w
            is_active = (i == self.active_tab)

            if is_active:
                cr.new_sub_path()
                cr.arc(tx + tab_w - bar_r, bar_y + bar_r, bar_r - 1.0, -math.pi/2, 0)
                cr.arc(tx + tab_w - bar_r, bar_y + bar_h - bar_r, bar_r - 1.0, 0, math.pi/2)
                cr.arc(tx + bar_r, bar_y + bar_h - bar_r, bar_r - 1.0, math.pi/2, math.pi)
                cr.arc(tx + bar_r, bar_y + bar_r, bar_r - 1.0, math.pi, 3*math.pi/2)
                cr.close_path()
                cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.12)
                cr.fill()

            layout = PangoCairo.create_layout(cr)
            font = Pango.FontDescription("Ubuntu, Sans Bold 8.5")
            layout.set_font_description(font)
            layout.set_text(title, -1)
            tw, th = layout.get_pixel_size()

            if is_active:
                cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.95)
            else:
                cr.set_source_rgba(0.55, 0.58, 0.65, alpha * 0.75)
            cr.move_to(tx + (tab_w - tw) / 2.0, bar_y + (bar_h - th) / 2.0)
            PangoCairo.show_layout(cr, layout)

        if self.active_tab == 0:
            self.draw_music_tab(cr, px, w, h, alpha)
        elif self.active_tab == 1:
            self.draw_ai_tab(cr, px, w, h, alpha)
        elif self.active_tab == 2:
            self.draw_focus_tab(cr, px, w, h, alpha)
        elif self.active_tab == 3:
            self.draw_shelf_tab(cr, px, w, h, alpha)

    def draw_music_tab(self, cr, px, w, h, alpha):
        cx = self.EXP_W / 2.0
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        if self.active_player and self.active_player.get('title'):
            title = self.active_player['title']
            artist = self.active_player['artist']
            status = self.active_player['status']
            is_playing = (status == 'Playing')
            source = self.detect_source(self.active_player)
            scolor = source['color']
            length = self.active_player.get('length', 0)
            pos = self.active_player.get('position', 0)

            # 1. 46x46 Solid Matte Album Card at X = px + 24, Y = 78
            card_x = px + 24
            card_y = 78
            card_s = 46
            card_r = 10

            cr.save()
            cr.new_path()
            cr.new_sub_path()
            cr.arc(card_x + card_s - card_r, card_y + card_r, card_r, -math.pi/2, 0)
            cr.arc(card_x + card_s - card_r, card_y + card_s - card_r, card_r, 0, math.pi/2)
            cr.arc(card_x + card_r, card_y + card_s - card_r, card_r, math.pi/2, math.pi)
            cr.arc(card_x + card_r, card_y + card_r, card_r, math.pi, 3*math.pi/2)
            cr.close_path()

            cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.05)
            cr.fill_preserve()
            cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.08)
            cr.set_line_width(1.0)
            cr.stroke()

            # Draw Logo inside card
            self.draw_source_logo(cr, card_x + card_s / 2.0, card_y + card_s / 2.0, card_s, source['type'])
            cr.restore()

            # 2. Middle: Text Info
            text_x = px + 80

            # Source badge
            font = Pango.FontDescription("Ubuntu, Sans Bold 8")
            layout.set_font_description(font)
            layout.set_text(source['label'], -1)
            cr.set_source_rgba(scolor[0], scolor[1], scolor[2], alpha * 0.95)
            cr.move_to(text_x, 78)
            PangoCairo.show_layout(cr, layout)

            # Minimal Flat Float Switch Pill on Top Right
            is_float_on = self.settings.get("floating_player_enabled", True)
            sw_w, sw_h, sw_r = 68.0, 18.0, 9.0
            sw_x = px + w - sw_w - 24
            sw_y = 78.0

            cr.save()
            cr.new_path()
            cr.new_sub_path()
            cr.arc(sw_x + sw_w - sw_r, sw_y + sw_r, sw_r, -math.pi/2, math.pi/2)
            cr.arc(sw_x + sw_r, sw_y + sw_r, sw_r, math.pi/2, 3*math.pi/2)
            cr.close_path()
            cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.06 if is_float_on else alpha * 0.03)
            cr.fill_preserve()
            cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.12 if is_float_on else alpha * 0.06)
            cr.set_line_width(1.0)
            cr.stroke()

            layout.set_font_description(Pango.FontDescription("Ubuntu, Sans 7.5"))
            layout.set_text("⧉ FLOAT", -1)
            tw, th = layout.get_pixel_size()
            cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.90 if is_float_on else alpha * 0.50)
            cr.move_to(sw_x + (sw_w - tw) / 2.0, sw_y + (sw_h - th) / 2.0)
            PangoCairo.show_layout(cr, layout)
            cr.restore()

            # Track Title (clean bold white)
            if len(title) > 28:
                display_title = title[:26] + ".."
            else:
                display_title = title
            font = Pango.FontDescription("Ubuntu, Sans Bold 11")
            layout.set_font_description(font)
            layout.set_text(display_title, -1)
            cr.set_source_rgba(0.96, 0.97, 0.98, alpha)
            cr.move_to(text_x, 92)
            PangoCairo.show_layout(cr, layout)

            # Artist (clean muted slate)
            if len(artist) > 34:
                display_artist = artist[:32] + ".."
            else:
                display_artist = artist
            font = Pango.FontDescription("Ubuntu, Sans 9")
            layout.set_font_description(font)
            layout.set_text(display_artist, -1)
            cr.set_source_rgba(0.55, 0.58, 0.65, alpha * 0.85)
            cr.move_to(text_x, 110)
            PangoCairo.show_layout(cr, layout)

            # 3. Scrubber Progress Bar (Solid, Zero Gradients) at Y = 140
            bar_x = px + 24
            bar_y = 140
            bar_w = w - 48
            pct = max(0.0, min(1.0, pos / length)) if length > 0 else 0.0

            # Elapsed and Total Time Labels
            layout.set_font_description(Pango.FontDescription("Ubuntu, Monospace 8"))
            layout.set_text(format_duration(pos), -1)
            cr.set_source_rgba(0.50, 0.53, 0.60, alpha * 0.85)
            cr.move_to(bar_x, bar_y - 12)
            PangoCairo.show_layout(cr, layout)

            layout.set_text(format_duration(length), -1)
            ptw, pth = layout.get_pixel_size()
            cr.move_to(bar_x + bar_w - ptw, bar_y - 12)
            PangoCairo.show_layout(cr, layout)

            # Progress Background Track (neutral rail)
            cr.save()
            cr.new_sub_path()
            br = 1.5
            cr.arc(bar_x + bar_w - br, bar_y + br, br, -math.pi/2, math.pi/2)
            cr.arc(bar_x + br, bar_y + br, br, math.pi/2, 3*math.pi/2)
            cr.close_path()
            cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.12)
            cr.fill()

            # Active Progress Track (pure solid white)
            if pct > 0.005:
                active_w = max(3.0, bar_w * pct)
                cr.new_sub_path()
                cr.arc(bar_x + active_w - br, bar_y + br, br, -math.pi/2, math.pi/2)
                cr.arc(bar_x + br, bar_y + br, br, math.pi/2, 3*math.pi/2)
                cr.close_path()
                cr.set_source_rgba(1.0, 1.0, 1.0, alpha * 0.90)
                cr.fill()

                # Solid White Thumb Knob
                cr.arc(bar_x + active_w, bar_y + br, 3.5, 0, 2 * math.pi)
                cr.set_source_rgba(1.0, 1.0, 1.0, alpha)
                cr.fill()
            cr.restore()

            # 4. Playback Controls at Y = 182
            btn_cy = 182

            # Far Left: Clean Minimal Volume Icon
            cr.save()
            cr.translate(px + 38, btn_cy)
            layout.set_font_description(Pango.FontDescription("Ubuntu, Sans 9.5"))
            layout.set_text("🔊", -1)
            sw, sh = layout.get_pixel_size()
            cr.set_source_rgba(0.50, 0.53, 0.60, alpha * 0.80)
            cr.move_to(-sw / 2.0, -sh / 2.0)
            PangoCairo.show_layout(cr, layout)
            cr.restore()

            # Crisp Vector Prev Button at cx - 52
            self.draw_vector_prev(cr, cx=cx - 52, cy=btn_cy, r=16, alpha=alpha)

            # Center Solid Off-White Play/Pause Button at cx (r=20)
            self.draw_vector_play_pause(cr, cx=cx, cy=btn_cy, r=20, is_playing=is_playing, alpha=alpha)

            # Crisp Vector Next Button at cx + 52
            self.draw_vector_next(cr, cx=cx + 52, cy=btn_cy, r=16, alpha=alpha)

            # Far Right: 5-bar Clean Audio Visualizer
            viz_cx = px + w - 38
            self.draw_visualizer_bars(
                cr, cx=viz_cx, cy=btn_cy, num_bars=5,
                is_playing=is_playing, color=[1.0, 1.0, 1.0],
                max_h=16.0, bar_w=2.0, bar_gap=2.2, alpha=alpha * 0.70
            )

        else:
            font = Pango.FontDescription("Ubuntu, Sans 10.5")
            layout.set_font_description(font)
            layout.set_text("Tidak ada musik yang sedang diputar", -1)
            tw, th = layout.get_pixel_size()
            cr.set_source_rgba(0.50, 0.53, 0.60, alpha * 0.75)
            cr.move_to(cx - tw / 2.0, 122)
            PangoCairo.show_layout(cr, layout)

