# ─── High Performance Fluid Spring ──────────────────────────────────
class FluidSpring:
    def __init__(self, stiffness=185.0, damping=14.5):
        self.val = 0.0
        self.target = 0.0
        self.vel = 0.0
        self.stiffness = stiffness
        self.damping = damping

    def set_target(self, target):
        self.target = float(target)

    def snap_to(self, target):
        self.val = float(target)
        self.target = float(target)
        self.vel = 0.0

    def update(self, dt):
        force = (self.target - self.val) * self.stiffness
        damping_force = self.vel * self.damping
        acc = force - damping_force
        self.vel += acc * dt
        self.val += self.vel * dt
        settled = abs(self.target - self.val) < 0.003 and abs(self.vel) < 0.006
        if settled:
            self.val = self.target
            self.vel = 0.0
        return settled

# ─── MPRIS Media Controller ─────────────────────────────────────────
class MprisController:
    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except Exception:
            self.bus = None

    def get_active_player(self):
        if not self.bus:
            return None
        try:
            proxy = Gio.DBusProxy.new_sync(
                self.bus, Gio.DBusProxyFlags.NONE, None,
                'org.freedesktop.DBus', '/org/freedesktop/DBus',
                'org.freedesktop.DBus', None
            )
            names = proxy.ListNames()
            players = [n for n in names if n.startswith('org.mpris.MediaPlayer2.')]
            if not players:
                return None

            best_player = None
            for p in players:
                try:
                    pp = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        p, '/org/mpris/MediaPlayer2',
                        'org.mpris.MediaPlayer2.Player', None
                    )
                    status_v = pp.get_cached_property('PlaybackStatus')
                    status = status_v.unpack() if status_v else 'Stopped'
                    meta_v = pp.get_cached_property('Metadata')
                    meta = meta_v.unpack() if meta_v else {}
                    title = meta.get('xesam:title', '')
                    artist_raw = meta.get('xesam:artist', [])
                    artist = ', '.join(artist_raw) if isinstance(artist_raw, list) else str(artist_raw or '')
                    url = meta.get('xesam:url', '')

                    length_raw = meta.get('mpris:length', 0)
                    length_sec = int(length_raw / 1_000_000) if length_raw else 0
                    track_id = meta.get('mpris:trackid', '/')

                    pos_sec = 0
                    try:
                        pos_v = pp.get_cached_property('Position')
                        if pos_v:
                            pos_sec = int(pos_v.unpack() / 1_000_000)
                    except Exception:
                        pass

                    info = {
                        'name': p,
                        'proxy': pp,
                        'status': status,
                        'title': str(title or 'Unknown Track'),
                        'artist': str(artist or 'Unknown Artist'),
                        'url': str(url or ''),
                        'length': length_sec,
                        'position': pos_sec,
                        'track_id': track_id
                    }
                    if status == 'Playing':
                        return info
                    if best_player is None and title:
                        best_player = info
                except Exception:
                    continue
            return best_player
        except Exception:
            return None

    def play_pause(self, player_info):
        if player_info and player_info.get('proxy'):
            try:
                player_info['proxy'].PlayPause()
            except Exception as e:
                print("[MPRIS] PlayPause error:", e)

    def next(self, player_info):
        if player_info and player_info.get('proxy'):
            try:
                player_info['proxy'].Next()
            except Exception as e:
                print("[MPRIS] Next error:", e)

    def previous(self, player_info):
        if player_info and player_info.get('proxy'):
            try:
                player_info['proxy'].Previous()
            except Exception as e:
                print("[MPRIS] Previous error:", e)

    def set_position(self, player_info, target_seconds):
        if player_info and player_info.get('proxy'):
            try:
                track_id = player_info.get('track_id', '/')
                player_info['proxy'].SetPosition('(ox)', track_id, int(target_seconds * 1_000_000))
            except Exception as e:
                print("[MPRIS] SetPosition error:", e)

# ─── Floating Detachable Music Island ────────────────────────────────
class FloatingMusicIsland(Gtk.Window):
    def __init__(self, main_notch):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.main_notch = main_notch
        self.set_name("bubu-floating-island")
        self.set_title("Bubu Music Island")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)

        self.W = 340
        self.H = 54
        self.set_default_size(self.W, self.H)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK
        )
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)

        # Positioning: Restore saved position or place at bottom-right
        geom = main_notch.get_monitor_geometry()
        saved_pos = main_notch.settings.get("floating_player_pos")
        if saved_pos and len(saved_pos) == 2:
            self.move(int(saved_pos[0]), int(saved_pos[1]))
        else:
            default_x = geom.x + geom.width - self.W - 35
            default_y = geom.y + geom.height - self.H - 65
            self.move(default_x, default_y)

    def on_button_press(self, widget, event):
        x, y = event.x, event.y

        # 1. Close / Hide Button (Top-Right: X > 316, Y < 24)
        if x >= 316 and y <= 24:
            self.main_notch.settings["floating_player_enabled"] = False
            save_settings(self.main_notch.settings)
            self.hide()
            self.main_notch.queue_draw()
            return True

        # 2. Play / Pause Button (Around X=266, Y=27, r=14)
        if 248 <= x <= 282 and 12 <= y <= 42:
            self.main_notch.mpris.play_pause(self.main_notch.active_player)
            return True

        # 3. Next Button (Around X=296, Y=27, r=12)
        if 284 <= x <= 312 and 14 <= y <= 40:
            self.main_notch.mpris.next(self.main_notch.active_player)
            return True

        # 4. Draggable anywhere else on the pill
        if event.button == 1:
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True

        return True

    def on_button_release(self, widget, event):
        pos = self.get_position()
        self.main_notch.settings["floating_player_pos"] = [pos[0], pos[1]]
        save_settings(self.main_notch.settings)
        return False

    def on_draw(self, widget, cr):
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        w, h, r = float(self.W), float(self.H), 27.0
        player = self.main_notch.active_player
        source = self.main_notch.detect_source(player)
        scolor = source['color']
        is_playing = (player and player.get('status') == 'Playing')

        # 1. Solid Matte Background (Zero gradients)
        cr.new_path()
        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi/2, math.pi/2)
        cr.arc(r, h - r, r, math.pi/2, 3*math.pi/2)
        cr.close_path()

        cr.set_source_rgba(0.05, 0.05, 0.06, 0.98) # #0d0d0f
        cr.fill_preserve()

        # Hairline precision border
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.09)
        cr.set_line_width(1.0)
        cr.stroke()

        # 2. Left: Logo Badge (34x34 at X=10, Y=10)
        card_x, card_y, card_s, card_r = 10.0, 10.0, 34.0, 8.0
        cr.save()
        cr.new_path()
        cr.new_sub_path()
        cr.arc(card_x + card_s - card_r, card_y + card_r, card_r, -math.pi/2, 0)
        cr.arc(card_x + card_s - card_r, card_y + card_s - card_r, card_r, 0, math.pi/2)
        cr.arc(card_x + card_r, card_y + card_s - card_r, card_r, math.pi/2, math.pi)
        cr.arc(card_x + card_r, card_y + card_r, card_r, math.pi, 3*math.pi/2)
        cr.close_path()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.05)
        cr.fill_preserve()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.08)
        cr.set_line_width(1.0)
        cr.stroke()

        self.main_notch.draw_source_logo(cr, card_x + card_s / 2.0, card_y + card_s / 2.0, card_s, source['type'])
        cr.restore()

        # 3. Middle: Text Info
        layout = PangoCairo.create_layout(cr)
        title = player.get('title') if player else "Tidak ada musik"
        artist = player.get('artist') if player else "Bubu Floating Player"

        if len(title) > 22:
            display_title = title[:20] + ".."
        else:
            display_title = title

        if len(artist) > 26:
            display_artist = artist[:24] + ".."
        else:
            display_artist = artist

        # Title
        font = Pango.FontDescription("Ubuntu, Sans Bold 9.5")
        layout.set_font_description(font)
        layout.set_text(display_title, -1)
        cr.set_source_rgba(0.96, 0.97, 0.98, 1.0)
        cr.move_to(52, 11)
        PangoCairo.show_layout(cr, layout)

        # Artist
        font = Pango.FontDescription("Ubuntu, Sans 8.5")
        layout.set_font_description(font)
        layout.set_text(display_artist, -1)
        cr.set_source_rgba(0.55, 0.58, 0.65, 0.85)
        cr.move_to(52, 29)
