    def scroll_chat_to_bottom(self):
        adj = self.chat_scroll.get_vadjustment()
        if adj:
            adj.set_value(max(adj.get_lower(), adj.get_upper() - adj.get_page_size()))
        return False

    # ─── VSync Frame Animation Engine ───────────────────────────────
    def ensure_animation(self):
        if self.tick_id == 0:
            self.last_tick_us = 0
            self.tick_id = self.add_tick_callback(self.on_frame_tick)

    def on_frame_tick(self, widget, frame_clock):
        now_us = frame_clock.get_frame_time()
        if self.last_tick_us == 0:
            dt = 0.016
        else:
            dt = min(0.04, max(0.005, (now_us - self.last_tick_us) / 1000000.0))
        self.last_tick_us = now_us

        settled = self.spring.update(dt)
        self.queue_draw()

        if settled:
            self.tick_id = 0
            if not self.is_expanded:
                # Physically snap window back to 166x30 pill
                self.resize(self.IDLE_W, self.IDLE_H)
                self.reposition(self.IDLE_W)
            return False
        return True

    def expand(self):
        self.cancel_retract()
        if self.is_expanded:
            return
        self.is_expanded = True
        self.mascot_state = "HAPPY"

        # Resize window to full canvas
        self.resize(self.EXP_W, self.EXP_H)
        self.reposition(self.EXP_W)

        # Trigger spring expansion
        self.spring.set_target(1.0)
        self.ensure_animation()
        self.update_widget_visibility()

    def retract(self):
        self.cancel_retract()
        if not self.is_expanded:
            return
        self.is_expanded = False
        self.drag_hover = False
        self.mascot_state = "AWAKE"

        if self.watchdog_id != 0:
            GLib.source_remove(self.watchdog_id)
            self.watchdog_id = 0

        # Trigger spring retraction
        self.spring.set_target(0.0)
        self.ensure_animation()
        self.update_widget_visibility()

    def cancel_retract(self):
        if self.retract_timer:
            GLib.source_remove(self.retract_timer)
            self.retract_timer = None

    def check_pointer_watchdog(self):
        return False

    # ─── Mouse Event Handling (Manual Click Only) ───────────────────
    def on_enter(self, widget, event):
        self.last_hover_time = time.time()
        self.last_interaction_time = time.time()
        self.is_hovered = True
        if self.mascot_state == "SLEEPY":
            self.mascot_state = "AWAKE"
            self.is_blinking = False
            self.next_blink_time = time.time() + 2.5
        display = Gdk.Display.get_default()
        win = self.get_window()
        if win and display:
            cursor = Gdk.Cursor.new_from_name(display, "pointer")
            win.set_cursor(cursor)
        self.queue_draw()
        return True

    def on_leave(self, widget, event):
        self.last_hover_time = time.time()
        self.is_hovered = False
        display = Gdk.Display.get_default()
        win = self.get_window()
        if win and display:
            win.set_cursor(None)
        self.queue_draw()
        return True

    def on_scroll(self, widget, event):
        self.last_interaction_time = time.time()
        if self.mascot_state == "SLEEPY":
            self.mascot_state = "AWAKE"

        if not self.is_expanded:
            return False

        if self.active_tab == 1 and self.chat_scroll.get_visible():
            adj = self.chat_scroll.get_vadjustment()
            if adj:
                smooth, dx, dy = event.get_scroll_deltas()
                delta = dy * 25.0 if smooth else (25.0 if event.direction == Gdk.ScrollDirection.DOWN else -25.0)
                adj.set_value(max(adj.get_lower(), min(adj.get_upper() - adj.get_page_size(), adj.get_value() + delta)))
                return True

        return False

    # ─── Drag & Drop ────────────────────────────────────────────────
    def on_drag_motion(self, widget, context, x, y, time_val):
        self.cancel_retract()
        if not self.is_expanded:
            self.drag_hover = True
            self.active_tab = 3 # File Shelf
            self.expand()
        Gdk.drag_status(context, Gdk.DragAction.COPY, time_val)
        return True

    def on_drag_leave(self, widget, context, time_val):
        if self.drag_hover:
            self.cancel_retract()
            self.retract_timer = GLib.timeout_add(450, self._do_retract)

    def _do_retract(self):
        self.retract()
        self.retract_timer = None
        return False

    def on_drag_drop(self, widget, context, x, y, data, info, time_val):
        uris = data.get_uris()
        context.finish(True, False, time_val)
        if uris:
            for u in uris:
                if u.startswith("file://"):
                    p = urllib.parse.unquote(urllib.parse.urlparse(u).path)
                    if os.path.exists(p):
                        if not any(item['path'] == p for item in self.shelf_items):
                            name = os.path.basename(p)
                            size_str = self.format_size(os.path.getsize(p)) if not os.path.isdir(p) else "Folder"
                            self.shelf_items.append({
                                "name": name,
                                "path": p,
                                "size": size_str,
                                "is_dir": os.path.isdir(p)
                            })
            save_shelf(self.shelf_items)
            self.active_tab = 3
            self.update_widget_visibility()
            self.queue_draw()
            subprocess.Popen(
                ["notify-send", "-a", "Bubu", "Bubu File Shelf", f"Menyimpan {len(uris)} file ke shelf."],
                env=dict(os.environ, DISPLAY=":0", XAUTHORITY=os.path.expanduser("~/.Xauthority"))
            )

    def format_size(self, size_bytes):
        if size_bytes < 1024:
            return f"{size_bytes} B"
        elif size_bytes < 1024 * 1024:
            return f"{size_bytes / 1024:.1f} KB"
        else:
            return f"{size_bytes / (1024 * 1024):.1f} MB"

    # ─── Periodic Tickers ───────────────────────────────────────────
    def on_second_tick(self):
        self.active_player = self.mpris.get_active_player()

        if self.pomo_running and self.pomo_time_left > 0:
            self.pomo_time_left -= 1
            if self.pomo_time_left == 0:
                self.pomo_running = False
                subprocess.Popen(
                    ["notify-send", "-a", "Bubu", "Bubu Focus Time", "Waktu fokus selesai! Istirahat sejenak ☕"],
                    env=dict(os.environ, DISPLAY=":0", XAUTHORITY=os.path.expanduser("~/.Xauthority"))
                )

        now = time.time()
        # If music is playing, mascot stays awake and sings
        if self.active_player and self.active_player.get('status') == 'Playing':
            self.last_interaction_time = now
            if self.mascot_state == "SLEEPY":
                self.mascot_state = "AWAKE"
        else:
            # 1 minute (60.0s) without interaction -> fall asleep
            if not self.is_expanded and (now - self.last_interaction_time > 60.0):
                if self.mascot_state != "SLEEPY":
                    self.mascot_state = "SLEEPY"
                    self.sleepy_z = 0.0
            elif not self.is_expanded and self.mascot_state == "SLEEPY" and (now - self.last_interaction_time <= 60.0):
                self.mascot_state = "AWAKE"

        self.queue_draw()
        if self.floating_player and self.floating_player.get_visible():
            self.floating_player.queue_draw()
        return True

    def on_fast_tick(self):
        now = time.time()

        # Animate Audio Visualizer Candle when playing or AI is thinking
        is_playing = (self.active_player and self.active_player.get('status') == 'Playing')
        if is_playing or self.ai_loading:
            self.visualizer_phase = (self.visualizer_phase + 0.18) % (math.pi * 20.0)
            self.queue_draw()
            if self.floating_player and self.floating_player.get_visible():
                self.floating_player.queue_draw()

        if self.mascot_state == "AWAKE":
            # 1. Blink exactly every 3 seconds
            if not self.is_blinking and now >= self.next_blink_time:
                self.is_blinking = True
                self.blink_start = now
            if self.is_blinking:
                dt = now - self.blink_start
                if dt < 0.12:
                    self.blink_progress = dt / 0.12
                elif dt < 0.24:
                    self.blink_progress = 1.0 - (dt - 0.12) / 0.12
                else:
                    self.is_blinking = False
                    self.blink_progress = 0.0
                    self.next_blink_time = now + 3.0
                self.queue_draw()

            # 2. Natural Gaze Look-Around (Front, Left, Right, Up, Down)
            if now >= self.next_gaze_time:
                r_val = int(now * 100) % 10
                if r_val in [0, 1, 2, 3]: # 40%: look forward / front
                    self.target_gaze_x = 0.0
                    self.target_gaze_y = 0.0
                elif r_val in [4, 5]: # 20%: look left (samping kiri)
                    self.target_gaze_x = -1.6
                    self.target_gaze_y = 0.0
                elif r_val in [6, 7]: # 20%: look right (samping kanan)
                    self.target_gaze_x = 1.6
                    self.target_gaze_y = 0.0
                elif r_val == 8: # 10%: look down (bawah)
                    self.target_gaze_x = 0.0
                    self.target_gaze_y = 1.2
                else: # 10%: look up (atas)
                    self.target_gaze_x = 0.0
                    self.target_gaze_y = -1.2
                self.next_gaze_time = now + 2.0 + (int(now * 10) % 20) / 10.0

            # Smooth fluid gaze interpolation
            dx = self.target_gaze_x - self.gaze_x
            dy = self.target_gaze_y - self.gaze_y
            if abs(dx) > 0.02 or abs(dy) > 0.02:
                self.gaze_x += dx * 0.20
                self.gaze_y += dy * 0.20
                self.queue_draw()

        elif self.mascot_state == "SLEEPY":
            self.sleepy_z = (self.sleepy_z + 0.07) % 6.0
            self.queue_draw()

        return True

    # ─── Source App Detection & Logo Rendering ──────────────────────
    def detect_source(self, player_info):
        if not player_info:
            return {'type': 'music', 'label': 'MUSIC', 'color': [0.70, 0.72, 0.80]}
        name = (player_info.get('name') or '').lower()
        title = (player_info.get('title') or '').lower()
        artist = (player_info.get('artist') or '').lower()
        url = (player_info.get('url') or '').lower()

        if 'spotify' in name or 'spotify' in url:
            return {'type': 'spotify', 'label': 'SPOTIFY', 'color': [0.11, 0.73, 0.33]}
        elif 'youtube' in url or 'youtube' in title or 'chromium' in name or 'chrome' in name or 'brave' in name or 'edge' in name:
            return {'type': 'youtube', 'label': 'YOUTUBE', 'color': [0.92, 0.20, 0.20]}
        elif 'vlc' in name:
            return {'type': 'vlc', 'label': 'VLC', 'color': [1.0, 0.55, 0.0]}
        elif 'firefox' in name:
            return {'type': 'firefox', 'label': 'FIREFOX', 'color': [1.0, 0.40, 0.15]}
        else:
            return {'type': 'local', 'label': 'LOCAL PLAYER', 'color': [0.70, 0.72, 0.80]}

