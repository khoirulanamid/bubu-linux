#!/usr/bin/python3
"""
Nusa for Linux — A living, interactive notch for Linux desktop.
Inspired by Nusa (https://rama2555.github.io/nusa/).

Engine v3.3:
- Ultra-Sleek Music Player:
  * Crisp geometric Cairo vector controls (no generic Unicode text glyphs).
  * Interactive Track Scrubber & Progress Bar (with time elapsed / total duration & seek support).
  * Compact glassmorphic Float Switch pill ([ ● FLOAT ON ]).
  * Ambient colored glow behind album/source artwork.
  * 5-bar animated Candle Suara visualizer dancing with the music.
- Singing Companion Mascot: Joyful singing eyes (^ ^), rhythmic bobbing mouth (o ↔ O), and floating musical note (♪).
- Detachable Floating Music Island: Draggable anywhere on the desktop, with hide/show toggle.
- Physical micro-window geometry: 166x30 when idle, strictly bounded to visible pill.
- Hardware pointer watchdog: Notch closes reliably and instantly when cursor leaves.
"""

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('Pango', '1.0')
gi.require_version('PangoCairo', '1.0')
gi.require_version('Gio', '2.0')
