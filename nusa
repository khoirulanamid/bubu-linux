    # ─── Content Click Interactions ─────────────────────────────────
    def on_button_press(self, widget, event):
        if not self.is_expanded:
            self.expand()
            return True

        x, y = event.x, event.y
        p = max(0.0, self.spring.val)
        cur_w = self.IDLE_W + p * (self.EXP_W - self.IDLE_W)
        px = (self.EXP_W - cur_w) / 2.0

        # Clicking top mascot area toggles retract
        if y <= 28 and px <= x <= px + cur_w:
            self.retract()
            return True

        # 1. Tab Navigation
        if 42 <= y <= 72:
            tab_w = (cur_w - 40) / len(self.tabs)
            for i in range(len(self.tabs)):
                tx = px + 20 + i * tab_w
                if tx <= x <= tx + tab_w:
                    self.active_tab = i
                    self.queue_draw()
                    return True

        # 2. Content Interactions
        if self.active_tab == 0: # Music
            cx = self.EXP_W / 2.0

            # 2a. Floating Mini Player Toggle Switch (Top-Right): X: cur_w - 110 .. cur_w - 15, Y: 78 .. 106
            if px + cur_w - 110 <= x <= px + cur_w - 15 and 78 <= y <= 106:
                is_on = not self.settings.get("floating_player_enabled", True)
                self.settings["floating_player_enabled"] = is_on
                save_settings(self.settings)
                if is_on:
                    self.floating_player.show_all()
                else:
                    self.floating_player.hide()
                self.queue_draw()
                return True

            # 2b. Scrubber Seek: Y: 133 .. 153, X: px + 24 .. px + cur_w - 24
            bar_x = px + 24
            bar_w = cur_w - 48
            if 133 <= y <= 153 and bar_x <= x <= bar_x + bar_w:
                if self.active_player and self.active_player.get('length', 0) > 0:
                    pct = max(0.0, min(1.0, (x - bar_x) / bar_w))
                    target_sec = int(pct * self.active_player['length'])
                    self.mpris.set_position(self.active_player, target_sec)
                    self.active_player['position'] = target_sec
                    self.queue_draw()
                return True

            # 2c. Playback Controls at Y=184
            btn_cy = 184
            if btn_cy - 24 <= y <= btn_cy + 24:
                # Prev Button (cx - 56, r=17)
                if cx - 74 <= x <= cx - 38:
                    self.mpris.previous(self.active_player)
                    return True
                # Play/Pause Button (cx, r=22)
                elif cx - 25 <= x <= cx + 25:
                    self.mpris.play_pause(self.active_player)
                    return True
                # Next Button (cx + 56, r=17)
                elif cx + 38 <= x <= cx + 74:
                    self.mpris.next(self.active_player)
                    return True

        elif self.active_tab == 1: # Focus
            btn_y = 166
            cx = self.EXP_W / 2.0
            if btn_y - 18 <= y <= btn_y + 18:
                if cx - 95 <= x <= cx - 10:
                    self.pomo_running = not self.pomo_running
                    self.queue_draw()
                    return True
                elif cx + 10 <= x <= cx + 95:
                    self.pomo_running = False
                    self.pomo_time_left = self.settings.get("pomodoro_duration", 25 * 60)
                    self.queue_draw()
                    return True

        elif self.active_tab == 2: # Shelf
            if px + cur_w - 90 <= x <= px + cur_w - 20 and 85 <= y <= 110:
                self.shelf_items = []
                save_shelf(self.shelf_items)
                self.queue_draw()
                return True

            item_y = 120
            for item in self.shelf_items[-3:]:
                if px + 20 <= x <= px + cur_w - 20 and item_y <= y <= item_y + 28:
                    subprocess.Popen(["xdg-open", item["path"]])
                    return True
                item_y += 32

        elif self.active_tab == 3: # Water
            btn_y = 166
            cx = self.EXP_W / 2.0
            if btn_y - 18 <= y <= btn_y + 18:
                if cx - 105 <= x <= cx - 35:
                    self.settings["water_current"] += 250
                    save_settings(self.settings)
                    self.queue_draw()
                    return True
                elif cx - 30 <= x <= cx + 40:
                    self.settings["water_current"] += 500
                    save_settings(self.settings)
                    self.queue_draw()
                    return True
                elif cx + 45 <= x <= cx + 105:
                    self.settings["water_current"] = 0
                    save_settings(self.settings)
                    self.queue_draw()
                    return True

        return True

    # ─── Cairo Render Pipeline ──────────────────────────────────────
    def on_draw(self, widget, cr):
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        if not self.is_expanded and self.spring.val == 0.0:
            # IDLE: Exactly fills the 166x30 window
            px = 0.0
            py = 0.0
            cur_w = float(self.IDLE_W)
            cur_h = float(self.IDLE_H)
            cur_r = 15.0

            self.draw_capsule_shape(cr, px, py, cur_w, cur_h, cur_r, 0.0)
            self.draw_idle_elements(cr, cur_w / 2.0, cur_h / 2.0, 1.0)
        else:
            # EXPANDING / EXPANDED: Canvas is 430x224
            p = max(0.0, self.spring.val)
            cur_w = self.IDLE_W + p * (self.EXP_W - self.IDLE_W)
            cur_h = self.IDLE_H + p * (self.EXP_H - self.IDLE_H)
            cur_r = 15.0 + min(1.0, p) * 13.0
            px = (self.EXP_W - cur_w) / 2.0
            py = 0.0

            self.draw_capsule_shape(cr, px, py, cur_w, cur_h, cur_r, p)

            # Layered transition
            idle_alpha = max(0.0, 1.0 - p * 3.0)
            if idle_alpha > 0.01:
                cr.save()
                self.draw_idle_elements(cr, self.EXP_W / 2.0, cur_h / 2.0, idle_alpha)
                cr.restore()

            exp_alpha = max(0.0, min(1.0, (p - 0.25) / 0.75))
            if exp_alpha > 0.01:
                slide_y = (1.0 - exp_alpha) * 8.0
                cr.save()
                cr.translate(0, -slide_y)
                self.draw_expanded_elements(cr, px, py, cur_w, cur_h, exp_alpha)
                cr.restore()

        return False

    def draw_capsule_shape(self, cr, px, py, w, h, r, p):
        cr.new_path()
        cr.new_sub_path()
        cr.move_to(px, 0)
        cr.line_to(px + w, 0)
        cr.line_to(px + w, h - r)
        cr.arc(px + w - r, h - r, r, 0, math.pi / 2)
        cr.line_to(px + r, h)
        cr.arc(px + r, h - r, r, math.pi / 2, math.pi)
        cr.close_path()

        # Obsidian Glass
        grad = cairo.LinearGradient(px, 0, px, h)
        grad.add_color_stop_rgba(0, 0.05, 0.06, 0.10, 0.96)
        grad.add_color_stop_rgba(1, 0.08, 0.09, 0.14, 0.98)
        cr.set_source(grad)
        cr.fill_preserve()

        # Glow Border
        accent = self.settings.get("theme_accent", [0.55, 0.50, 0.95])
        border_alpha = 0.40 + p * 0.35 if not self.drag_hover else 0.95
        cr.set_source_rgba(accent[0], accent[1], accent[2], border_alpha)
        cr.set_line_width(1.2 + p * 0.6)
        cr.stroke()

    def draw_idle_elements(self, cr, cx, cy, alpha):
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        is_music_playing = (self.active_player and self.active_player.get('status') == 'Playing')

        # 1. When Music is Playing: Top Notch shows the CUTE SINGING MASCOT!
        if is_music_playing:
            source = self.detect_source(self.active_player)
            scolor = source['color']

            # Digital Clock on Left
            font = Pango.FontDescription("Ubuntu, Sans Bold 9.5")
            layout.set_font_description(font)
            current_time = time.strftime("%H:%M")
            layout.set_text(current_time, -1)
            lw, lh = layout.get_pixel_size()
            cr.set_source_rgba(0.92, 0.94, 0.98, alpha * 0.90)
            cr.move_to(cx - 62, cy - lh / 2.0)
            PangoCairo.show_layout(cr, layout)

            # Cute Singing Mascot in Center!
            self.draw_singing_mascot(cr, cx, cy, alpha)

            # Mini 3-bar animated candle visualizer on Right
            self.draw_visualizer_bars(cr, cx + 56, cy, num_bars=3, is_playing=True, color=scolor, max_h=12.0, bar_w=2.2, bar_gap=2.0, alpha=alpha)
            return

        # 2. Pomodoro Active
        if self.pomo_running:
            mins = self.pomo_time_left // 60
            secs = self.pomo_time_left % 60
            font = Pango.FontDescription("Ubuntu, Monospace Bold 10")
            layout.set_font_description(font)
            layout.set_text(f"⏱ {mins:02d}:{secs:02d}", -1)
            lw, lh = layout.get_pixel_size()
            cr.set_source_rgba(0.98, 0.45, 0.45, alpha * 0.95)
            cr.move_to(cx - lw / 2.0, cy - lh / 2.0)
            PangoCairo.show_layout(cr, layout)
            return

        # 3. Clean Centered Companion or Clock
        now = time.time()
        is_quiet = (now - self.last_hover_time > 15.0)

        if is_quiet or self.mascot_state == "SLEEPY":
            self.draw_mascot_eyes(cr, cx, cy, alpha)
        else:
            font = Pango.FontDescription("Ubuntu, Sans Bold 11")
            layout.set_font_description(font)
            current_time = time.strftime("%H:%M")
            layout.set_text(current_time, -1)
            lw, lh = layout.get_pixel_size()
            cr.set_source_rgba(0.95, 0.96, 1.0, alpha * 0.95)
            cr.move_to(cx - lw / 2.0, cy - lh / 2.0)
            PangoCairo.show_layout(cr, layout)

    def draw_singing_mascot(self, cr, cx, cy, alpha=1.0):
        spacing = 9.5
        rx = 3.2

        cr.save()
        cr.new_path()

        # Happy Singing Eyes ^ ^
        cr.set_source_rgba(0.95, 0.98, 1.0, alpha)
        cr.set_line_width(1.8)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)

        cr.new_sub_path()
        cr.arc(cx - spacing, cy - 2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
        cr.stroke()

        cr.new_sub_path()
        cr.arc(cx + spacing, cy - 2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
        cr.stroke()

        # Cute Singing Mouth o ↔ O bobbing with music
        mouth_scale = 1.0 + 0.6 * math.sin(self.visualizer_phase * 2.0)
        cr.new_sub_path()
        cr.save()
        cr.translate(cx, cy + 4.5)
        cr.scale(1.0, mouth_scale)
        cr.arc(0, 0, 2.4, 0, 2 * math.pi)
        cr.restore()
        cr.set_source_rgba(0.98, 0.50, 0.60, alpha * 0.95) # soft cute coral/pink
        cr.fill()

        # Floating Musical Note ♪
        layout = PangoCairo.create_layout(cr)
        font = Pango.FontDescription("Ubuntu, Sans Bold 8")
        layout.set_font_description(font)
        note = "♫" if int(self.visualizer_phase) % 2 == 0 else "♪"
        layout.set_text(note, -1)
        cr.set_source_rgba(0.55, 0.85, 1.0, alpha * 0.90)
        note_bob = 2.0 * math.sin(self.visualizer_phase)
        cr.move_to(cx + spacing + 6, cy - 8 + note_bob)
        PangoCairo.show_layout(cr, layout)

        cr.restore()

    def draw_mascot_eyes(self, cr, cx, cy, alpha=1.0):
        spacing = 11.0
        rx = 3.6
        ry = rx * max(0.12, 1.0 - self.blink_progress)

        cr.save()
        cr.new_path()

        if self.mascot_state == "AWAKE" or self.mascot_state == "BLINK":
            cr.set_source_rgba(0.95, 0.98, 1.0, alpha)
            for ex in [cx - spacing, cx + spacing]:
                cr.save()
                cr.translate(ex, cy)
                cr.scale(rx, ry)
                cr.new_sub_path()
                cr.arc(0, 0, 1.0, 0, 2 * math.pi)
                cr.fill()
                cr.restore()

        elif self.mascot_state == "HAPPY":
            cr.set_source_rgba(0.95, 0.98, 1.0, alpha)
            cr.set_line_width(2.0)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.new_sub_path()
            cr.arc(cx - spacing, cy + 1.2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
            cr.stroke()
            cr.new_sub_path()
            cr.arc(cx + spacing, cy + 1.2, rx, math.pi + 0.35, 2 * math.pi - 0.35)
            cr.stroke()

        elif self.mascot_state == "SLEEPY":
            cr.set_source_rgba(0.70, 0.75, 0.88, alpha * 0.85)
            cr.set_line_width(1.8)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.new_sub_path()
            cr.arc(cx - spacing, cy - 0.5, rx, 0.35, math.pi - 0.35)
            cr.stroke()
            cr.new_sub_path()
            cr.arc(cx + spacing, cy - 0.5, rx, 0.35, math.pi - 0.35)
            cr.stroke()

            cr.new_path()
            layout = PangoCairo.create_layout(cr)
            font = Pango.FontDescription("Ubuntu, Sans 8")
            layout.set_font_description(font)
            layout.set_text("z", -1)
            cr.move_to(cx + spacing + 7, cy - 3 - self.sleepy_z)
            accent = self.settings.get("theme_accent", [0.55, 0.50, 0.95])
            cr.set_source_rgba(accent[0], accent[1], accent[2], alpha * 0.85)
            PangoCairo.show_layout(cr, layout)

        cr.restore()

    def draw_expanded_elements(self, cr, px, py, w, h, alpha):
        cx = self.EXP_W / 2.0

        # Mascot top center
        self.draw_mascot_eyes(cr, cx, 18.0, alpha)

        # Tab Navigation
        tab_w = (w - 40) / len(self.tabs)
        tab_y = 38.0
        tab_h = 26.0

        for i, title in enumerate(self.tabs):
            tx = px + 20 + i * tab_w
            is_active = (i == self.active_tab)

            cr.save()
            r = 7.0
            cr.new_path()
            cr.new_sub_path()
            cr.arc(tx + r, tab_y + r, r, math.pi, math.pi * 1.5)
            cr.arc(tx + tab_w - r, tab_y + r, r, math.pi * 1.5, 0)
            cr.arc(tx + tab_w - r, tab_y + tab_h - r, r, 0, math.pi * 0.5)
            cr.arc(tx + r, tab_y + tab_h - r, r, math.pi * 0.5, math.pi)
            cr.close_path()

            if is_active:
                cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.40)
                cr.fill_preserve()
                cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.85)
                cr.set_line_width(1.2)
                cr.stroke()
            else:
                cr.set_source_rgba(0.12, 0.14, 0.22, alpha * 0.45)
                cr.fill()

            layout = PangoCairo.create_layout(cr)
            font = Pango.FontDescription("Ubuntu, Sans Bold 9")
            layout.set_font_description(font)
            layout.set_text(title, -1)
            tw, th = layout.get_pixel_size()

            if is_active:
                cr.set_source_rgba(1.0, 1.0, 1.0, alpha)
            else:
                cr.set_source_rgba(0.68, 0.72, 0.85, alpha * 0.75)
            cr.move_to(tx + (tab_w - tw) / 2.0, tab_y + (tab_h - th) / 2.0)
            PangoCairo.show_layout(cr, layout)
            cr.restore()

        # Divider
        cr.new_path()
        cr.move_to(px + 22, 73)
        cr.line_to(px + w - 22, 73)
        cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.22)
        cr.set_line_width(1.0)
        cr.stroke()

        if self.active_tab == 0:
            self.draw_music_tab(cr, px, w, h, alpha)
        elif self.active_tab == 1:
            self.draw_focus_tab(cr, px, w, h, alpha)
        elif self.active_tab == 2:
            self.draw_shelf_tab(cr, px, w, h, alpha)
        elif self.active_tab == 3:
            self.draw_water_tab(cr, px, w, h, alpha)

    def draw_music_tab(self, cr, px, w, h, alpha):
        cx = self.EXP_W / 2.0
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        if self.active_player and self.active_player.get('title'):
            title = self.active_player['title']
            artist = self.active_player['artist']
            status = self.active_player['status']
            is_playing = (status == 'Playing')
            source = self.detect_source(self.active_player)
            scolor = source['color']
            length = self.active_player.get('length', 0)
            pos = self.active_player.get('position', 0)

            # 1. Ambient soft glow behind album artwork
            glow_cx, glow_cy = px + 48, 108
            glow = cairo.RadialGradient(glow_cx, glow_cy, 6, glow_cx, glow_cy, 52)
            glow.add_color_stop_rgba(0, scolor[0], scolor[1], scolor[2], alpha * 0.24)
            glow.add_color_stop_rgba(1, scolor[0], scolor[1], scolor[2], 0.0)
            cr.set_source(glow)
            cr.arc(glow_cx, glow_cy, 52, 0, 2 * math.pi)
            cr.fill()

            # 2. 48x48 Album / App Glass Card at X = px + 24, Y = 84
            card_x = px + 24
            card_y = 84
            card_s = 48
            card_r = 13

            cr.save()
            cr.new_path()
            cr.new_sub_path()
            cr.arc(card_x + card_s - card_r, card_y + card_r, card_r, -math.pi/2, 0)
            cr.arc(card_x + card_s - card_r, card_y + card_s - card_r, card_r, 0, math.pi/2)
            cr.arc(card_x + card_r, card_y + card_s - card_r, card_r, math.pi/2, math.pi)
            cr.arc(card_x + card_r, card_y + card_r, card_r, math.pi, 3*math.pi/2)
            cr.close_path()

            cr.set_source_rgba(0.12, 0.14, 0.22, alpha * 0.94)
            cr.fill_preserve()
            cr.set_source_rgba(scolor[0], scolor[1], scolor[2], alpha * 0.50)
            cr.set_line_width(1.2)
            cr.stroke()

            # Draw Logo inside card
            self.draw_source_logo(cr, card_x + card_s / 2.0, card_y + card_s / 2.0, card_s, source['type'])
            cr.restore()

            # 3. Middle: Text Info
            text_x = px + 82

            # Source badge
            font = Pango.FontDescription("Ubuntu, Sans Bold 8")
            layout.set_font_description(font)
            layout.set_text(f"● {source['label']}", -1)
            cr.set_source_rgba(scolor[0], scolor[1], scolor[2], alpha * 0.95)
            cr.move_to(text_x, 84)
            PangoCairo.show_layout(cr, layout)

            # Compact Glassmorphic Float Switch Pill at Top-Right
            is_float_on = self.settings.get("floating_player_enabled", True)
            sw_w, sw_h, sw_r = 76.0, 20.0, 10.0
            sw_x = px + w - sw_w - 24
            sw_y = 83.0

            cr.save()
            cr.new_path()
            cr.new_sub_path()
            cr.arc(sw_x + sw_w - sw_r, sw_y + sw_r, sw_r, -math.pi/2, math.pi/2)
            cr.arc(sw_x + sw_r, sw_y + sw_r, sw_r, math.pi/2, 3*math.pi/2)
            cr.close_path()
            if is_float_on:
                cr.set_source_rgba(0.16, 0.19, 0.30, alpha * 0.88)
                cr.fill_preserve()
                cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.65)
                cr.set_line_width(1.0)
                cr.stroke()
                # Active Green Dot
                cr.arc(sw_x + 9, sw_y + 10, 2.8, 0, 2 * math.pi)
                cr.set_source_rgba(0.2, 0.9, 0.4, alpha * 0.95)
                cr.fill()
                float_txt = "FLOAT ON"
            else:
                cr.set_source_rgba(0.12, 0.14, 0.20, alpha * 0.70)
                cr.fill_preserve()
                cr.set_source_rgba(0.40, 0.44, 0.55, alpha * 0.40)
                cr.set_line_width(1.0)
                cr.stroke()
                # Muted Dot
                cr.arc(sw_x + 9, sw_y + 10, 2.8, 0, 2 * math.pi)
                cr.set_source_rgba(0.55, 0.60, 0.70, alpha * 0.70)
                cr.fill()
                float_txt = "FLOAT OFF"

            layout.set_font_description(Pango.FontDescription("Ubuntu, Sans Bold 7.5"))
            layout.set_text(float_txt, -1)
            cr.set_source_rgba(0.92, 0.95, 1.0, alpha * 0.95 if is_float_on else alpha * 0.65)
            cr.move_to(sw_x + 16, sw_y + 4.5)
            PangoCairo.show_layout(cr, layout)
            cr.restore()

            # Track Title
            if len(title) > 28:
                display_title = title[:26] + ".."
            else:
                display_title = title
            font = Pango.FontDescription("Ubuntu, Sans Bold 11.5")
            layout.set_font_description(font)
            layout.set_text(display_title, -1)
            cr.set_source_rgba(0.96, 0.98, 1.0, alpha)
            cr.move_to(text_x, 98)
            PangoCairo.show_layout(cr, layout)

            # Artist
            if len(artist) > 34:
                display_artist = artist[:32] + ".."
            else:
                display_artist = artist
            font = Pango.FontDescription("Ubuntu, Sans 9.5")
            layout.set_font_description(font)
            layout.set_text(display_artist, -1)
            cr.set_source_rgba(0.68, 0.72, 0.85, alpha * 0.85)
            cr.move_to(text_x, 116)
            PangoCairo.show_layout(cr, layout)

            # 4. Sleek Interactive Progress Bar (Scrubber) at Y = 143
            bar_x = px + 24
            bar_y = 143
            bar_w = w - 48
            bar_h = 3.5
            pct = max(0.0, min(1.0, pos / length)) if length > 0 else 0.0

            # Elapsed and Total Time Labels
            layout.set_font_description(Pango.FontDescription("Ubuntu, Monospace Bold 8"))
            layout.set_text(format_duration(pos), -1)
            cr.set_source_rgba(0.65, 0.70, 0.82, alpha * 0.85)
            cr.move_to(bar_x, bar_y - 12)
            PangoCairo.show_layout(cr, layout)

            layout.set_text(format_duration(length), -1)
            ptw, pth = layout.get_pixel_size()
            cr.move_to(bar_x + bar_w - ptw, bar_y - 12)
            PangoCairo.show_layout(cr, layout)

            # Progress Background Track
            cr.save()
            cr.new_sub_path()
            br = 1.75
            cr.arc(bar_x + bar_w - br, bar_y + br, br, -math.pi/2, math.pi/2)
            cr.arc(bar_x + br, bar_y + br, br, math.pi/2, 3*math.pi/2)
            cr.close_path()
            cr.set_source_rgba(0.18, 0.22, 0.32, alpha * 0.75)
            cr.fill()

            # Active Progress Track
            if pct > 0.005:
                active_w = max(4.0, bar_w * pct)
                cr.new_sub_path()
                cr.arc(bar_x + active_w - br, bar_y + br, br, -math.pi/2, math.pi/2)
                cr.arc(bar_x + br, bar_y + br, br, math.pi/2, 3*math.pi/2)
                cr.close_path()
                grad_bar = cairo.LinearGradient(bar_x, 0, bar_x + active_w, 0)
                grad_bar.add_color_stop_rgba(0, 0.55, 0.50, 0.95, alpha * 0.9)
                grad_bar.add_color_stop_rgba(1, 0.85, 0.55, 0.95, alpha * 1.0)
                cr.set_source(grad_bar)
                cr.fill()

                # Glowing Thumb Knob
                cr.arc(bar_x + active_w, bar_y + br, 4.0, 0, 2 * math.pi)
                cr.set_source_rgba(1.0, 1.0, 1.0, alpha)
                cr.fill_preserve()
                cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.8)
                cr.set_line_width(1.3)
                cr.stroke()
            cr.restore()

            # 5. Playback Controls at Y = 184
            btn_cy = 184

            # Far Left: Subtle Volume Icon
            cr.save()
            cr.translate(px + 38, btn_cy)
            cr.set_source_rgba(0.60, 0.65, 0.78, alpha * 0.80)
            layout.set_font_description(Pango.FontDescription("Ubuntu, Sans 10"))
            layout.set_text("🔊", -1)
            sw, sh = layout.get_pixel_size()
            cr.move_to(-sw / 2.0, -sh / 2.0)
            PangoCairo.show_layout(cr, layout)
            cr.restore()

            # Crisp Vector Prev Button at cx - 56
            self.draw_vector_prev(cr, cx=cx - 56, cy=btn_cy, r=17, alpha=alpha)

            # Center Glowing Vector Play/Pause Button at cx (r=22)
            self.draw_vector_play_pause(cr, cx=cx, cy=btn_cy, r=22, is_playing=is_playing, alpha=alpha)

            # Crisp Vector Next Button at cx + 56
            self.draw_vector_next(cr, cx=cx + 56, cy=btn_cy, r=17, alpha=alpha)

            # Far Right: 5-bar Animated Candle Suara
            viz_cx = px + w - 38
            self.draw_visualizer_bars(
                cr, cx=viz_cx, cy=btn_cy, num_bars=5,
                is_playing=is_playing, color=scolor,
                max_h=24.0, bar_w=3.2, bar_gap=2.5, alpha=alpha
            )

        else:
            font = Pango.FontDescription("Ubuntu, Sans 11")
            layout.set_font_description(font)
            layout.set_text("Tidak ada musik yang sedang diputar", -1)
            tw, th = layout.get_pixel_size()
            cr.set_source_rgba(0.60, 0.65, 0.78, alpha * 0.75)
            cr.move_to(cx - tw / 2.0, 122)
            PangoCairo.show_layout(cr, layout)

    def draw_focus_tab(self, cr, px, w, h, alpha):
        cx = self.EXP_W / 2.0
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        mins = self.pomo_time_left // 60
        secs = self.pomo_time_left % 60
        font = Pango.FontDescription("Ubuntu, Monospace Bold 26")
        layout.set_font_description(font)
        layout.set_text(f"{mins:02d}:{secs:02d}", -1)
        tw, th = layout.get_pixel_size()

        cr.set_source_rgba(0.95, 0.98, 1.0, alpha)
        cr.move_to(cx - tw / 2.0, 95)
        PangoCairo.show_layout(cr, layout)

        btn_y = 166
        label = "JEDA" if self.pomo_running else "MULAI FOKUS"
        self.draw_rect_btn(cr, cx - 92, btn_y - 14, 84, 28, label, highlight=self.pomo_running, alpha=alpha)
        self.draw_rect_btn(cr, cx + 10, btn_y - 14, 84, 28, "RESET", alpha=alpha)

    def draw_shelf_tab(self, cr, px, w, h, alpha):
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        font = Pango.FontDescription("Ubuntu, Sans Bold 10")
        layout.set_font_description(font)
        layout.set_text(f"LACI FILE ({len(self.shelf_items)})", -1)
        cr.set_source_rgba(0.70, 0.74, 0.88, alpha * 0.9)
        cr.move_to(px + 22, 88)
        PangoCairo.show_layout(cr, layout)

        if self.shelf_items:
            self.draw_rect_btn(cr, px + w - 75, 84, 55, 22, "KOSONGKAN", font_size=8, alpha=alpha)

        if not self.shelf_items:
            font = Pango.FontDescription("Ubuntu, Sans 10")
            layout.set_font_description(font)
            layout.set_text("⇣ Seret & lepas file ke sini untuk menyimpan", -1)
            tw, th = layout.get_pixel_size()
            cr.set_source_rgba(0.55, 0.60, 0.75, alpha * 0.7)
            cr.move_to(self.EXP_W / 2.0 - tw / 2.0, 136)
            PangoCairo.show_layout(cr, layout)
        else:
            item_y = 115
            for item in self.shelf_items[-3:]:
                name = item["name"]
                if len(name) > 28:
                    name = name[:26] + "..."
                size = item.get("size", "")

                cr.save()
                cr.new_path()
                cr.rectangle(px + 20, item_y, w - 40, 26)
                cr.set_source_rgba(0.12, 0.14, 0.22, alpha * 0.6)
                cr.fill_preserve()
                cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.3)
                cr.set_line_width(1.0)
                cr.stroke()

                font = Pango.FontDescription("Ubuntu, Sans 9")
                layout.set_font_description(font)
                layout.set_text(f"📄  {name}", -1)
                cr.set_source_rgba(0.92, 0.95, 1.0, alpha * 0.95)
                cr.move_to(px + 28, item_y + 4)
                PangoCairo.show_layout(cr, layout)

                layout.set_text(size, -1)
                sw, sh = layout.get_pixel_size()
                cr.set_source_rgba(0.65, 0.68, 0.80, alpha * 0.75)
                cr.move_to(px + w - sw - 28, item_y + 4)
                PangoCairo.show_layout(cr, layout)
                cr.restore()
                item_y += 30

    def draw_water_tab(self, cr, px, w, h, alpha):
        cx = self.EXP_W / 2.0
        cr.new_path()
        layout = PangoCairo.create_layout(cr)

        cur = self.settings.get("water_current", 500)
        goal = self.settings.get("water_goal", 2000)
        pct = min(100, int((cur / goal) * 100))

        font = Pango.FontDescription("Ubuntu, Sans Bold 20")
        layout.set_font_description(font)
        layout.set_text(f"{cur / 1000.0:.1f} / {goal / 1000.0:.1f} L  ({pct}%)", -1)
        tw, th = layout.get_pixel_size()

        cr.set_source_rgba(0.35, 0.78, 1.0, alpha)
        cr.move_to(cx - tw / 2.0, 95)
        PangoCairo.show_layout(cr, layout)

        bar_w = w - 80
        bar_x = px + 40
        bar_y = 130
        bar_h = 8

        cr.save()
        cr.new_path()
        cr.rectangle(bar_x, bar_y, bar_w, bar_h)
        cr.set_source_rgba(0.12, 0.15, 0.22, alpha * 0.8)
        cr.fill()

        fill_w = bar_w * (pct / 100.0)
        if fill_w > 0:
            cr.rectangle(bar_x, bar_y, fill_w, bar_h)
            cr.set_source_rgba(0.35, 0.78, 1.0, alpha * 0.9)
            cr.fill()
        cr.restore()

        btn_y = 166
        self.draw_rect_btn(cr, cx - 105, btn_y - 14, 66, 28, "+250 ml", alpha=alpha)
        self.draw_rect_btn(cr, cx - 33, btn_y - 14, 66, 28, "+500 ml", alpha=alpha)
        self.draw_rect_btn(cr, cx + 40, btn_y - 14, 65, 28, "RESET", alpha=alpha)

    # ─── UI Primitives ──────────────────────────────────────────────
    def draw_rect_btn(self, cr, bx, by, bw, bh, text, highlight=False, font_size=9, alpha=1.0):
        cr.save()
        r = 6.0
        cr.new_path()
        cr.new_sub_path()
        cr.arc(bx + r, by + r, r, math.pi, math.pi * 1.5)
        cr.arc(bx + bw - r, by + r, r, math.pi * 1.5, 0)
        cr.arc(bx + bw - r, by + bh - r, r, 0, math.pi * 0.5)
        cr.arc(bx + r, by + bh - r, r, math.pi * 0.5, math.pi)
        cr.close_path()

        if highlight:
            cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.9)
            cr.fill_preserve()
            cr.set_source_rgba(0.85, 0.82, 1.0, alpha)
            cr.set_line_width(1.5)
            cr.stroke()
        else:
            cr.set_source_rgba(0.15, 0.17, 0.26, alpha * 0.8)
            cr.fill_preserve()
            cr.set_source_rgba(0.55, 0.50, 0.95, alpha * 0.4)
            cr.set_line_width(1.0)
            cr.stroke()

        layout = PangoCairo.create_layout(cr)
        font = Pango.FontDescription(f"Ubuntu, Sans Bold {font_size}")
        layout.set_font_description(font)
        layout.set_text(text, -1)
        tw, th = layout.get_pixel_size()

        cr.set_source_rgba(1.0, 1.0, 1.0, alpha)
        cr.move_to(bx + (bw - tw) / 2.0, by + (bh - th) / 2.0)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

def main():
    lock_file = open('/tmp/nusa-linux.lock', 'w')
    try:
        fcntl.lockf(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except IOError:
        print("Nusa is already running.")
        sys.exit(0)

    app = NusaNotch()
    Gtk.main()

if __name__ == "__main__":
    main()
