import os
import sys
import json
import urllib.parse
import subprocess
import fcntl

CONFIG_DIR = os.path.expanduser("~/.config/nusa")
CONFIG_FILE = os.path.join(CONFIG_DIR, "settings.json")
SHELF_FILE = os.path.join(CONFIG_DIR, "shelf.json")

os.makedirs(CONFIG_DIR, exist_ok=True)

DEFAULT_SETTINGS = {
    "mascot_enabled": True,
    "pomodoro_duration": 25 * 60,
    "water_goal": 2000,
    "water_current": 500,
    "water_date": time.strftime("%Y-%m-%d"),
    "theme_accent": [0.55, 0.50, 0.95], # Nusa Vibrant Purple
    "start_with_system": True,
    "floating_player_enabled": True,
    "floating_player_pos": None
}

def load_settings():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, 'r') as f:
                data = json.load(f)
                s = dict(DEFAULT_SETTINGS)
                s.update(data)
                today = time.strftime("%Y-%m-%d")
                if s.get("water_date") != today:
                    s["water_date"] = today
                    s["water_current"] = 0
                return s
        except Exception:
            pass
    return dict(DEFAULT_SETTINGS)

def save_settings(settings):
    try:
        with open(CONFIG_FILE, 'w') as f:
            json.dump(settings, f, indent=2)
    except Exception as e:
        print("[Nusa] Error saving settings:", e)

def load_shelf():
    if os.path.exists(SHELF_FILE):
        try:
            with open(SHELF_FILE, 'r') as f:
                return json.load(f)
        except Exception:
            pass
    return []

def save_shelf(shelf_items):
    try:
        with open(SHELF_FILE, 'w') as f:
            json.dump(shelf_items, f, indent=2)
    except Exception as e:
        print("[Nusa] Error saving shelf:", e)

def format_duration(seconds):
    if seconds <= 0:
        return "00:00"
    m = seconds // 60
    s = seconds % 60
    if m >= 60:
        h = m // 60
        m = m % 60
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"

# ─── High Performance Fluid Spring ──────────────────────────────────
class FluidSpring:
    def __init__(self, stiffness=185.0, damping=14.5):
        self.val = 0.0
        self.target = 0.0
        self.vel = 0.0
        self.stiffness = stiffness
        self.damping = damping

    def set_target(self, target):
        self.target = float(target)

    def snap_to(self, target):
        self.val = float(target)
        self.target = float(target)
        self.vel = 0.0

    def update(self, dt):
        force = (self.target - self.val) * self.stiffness
        damping_force = self.vel * self.damping
        acc = force - damping_force
        self.vel += acc * dt
        self.val += self.vel * dt
        settled = abs(self.target - self.val) < 0.003 and abs(self.vel) < 0.006
        if settled:
            self.val = self.target
            self.vel = 0.0
        return settled

# ─── MPRIS Media Controller ─────────────────────────────────────────
class MprisController:
    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except Exception:
            self.bus = None

    def get_active_player(self):
        if not self.bus:
            return None
        try:
            proxy = Gio.DBusProxy.new_sync(
                self.bus, Gio.DBusProxyFlags.NONE, None,
                'org.freedesktop.DBus', '/org/freedesktop/DBus',
                'org.freedesktop.DBus', None
            )
            names = proxy.ListNames()
            players = [n for n in names if n.startswith('org.mpris.MediaPlayer2.')]
            if not players:
                return None

            best_player = None
            for p in players:
                try:
                    pp = Gio.DBusProxy.new_sync(
                        self.bus, Gio.DBusProxyFlags.NONE, None,
                        p, '/org/mpris/MediaPlayer2',
                        'org.mpris.MediaPlayer2.Player', None
                    )
                    status_v = pp.get_cached_property('PlaybackStatus')
                    status = status_v.unpack() if status_v else 'Stopped'
                    meta_v = pp.get_cached_property('Metadata')
                    meta = meta_v.unpack() if meta_v else {}
                    title = meta.get('xesam:title', '')
                    artist_raw = meta.get('xesam:artist', [])
                    artist = ', '.join(artist_raw) if isinstance(artist_raw, list) else str(artist_raw or '')
                    url = meta.get('xesam:url', '')

                    length_raw = meta.get('mpris:length', 0)
                    length_sec = int(length_raw / 1_000_000) if length_raw else 0
                    track_id = meta.get('mpris:trackid', '/')

                    pos_sec = 0
                    try:
                        pos_v = pp.get_cached_property('Position')
                        if pos_v:
                            pos_sec = int(pos_v.unpack() / 1_000_000)
                    except Exception:
                        pass

                    info = {
                        'name': p,
                        'proxy': pp,
                        'status': status,
                        'title': str(title or 'Unknown Track'),
                        'artist': str(artist or 'Unknown Artist'),
                        'url': str(url or ''),
                        'length': length_sec,
                        'position': pos_sec,
                        'track_id': track_id
                    }
                    if status == 'Playing':
                        return info
                    if best_player is None and title:
                        best_player = info
                except Exception:
                    continue
            return best_player
        except Exception:
            return None

    def play_pause(self, player_info):
        if player_info and player_info.get('proxy'):
            try:
                player_info['proxy'].PlayPause()
            except Exception as e:
                print("[MPRIS] PlayPause error:", e)

    def next(self, player_info):
        if player_info and player_info.get('proxy'):
            try:
                player_info['proxy'].Next()
            except Exception as e:
                print("[MPRIS] Next error:", e)

    def previous(self, player_info):
        if player_info and player_info.get('proxy'):
            try:
                player_info['proxy'].Previous()
            except Exception as e:
                print("[MPRIS] Previous error:", e)

    def set_position(self, player_info, target_seconds):
        if player_info and player_info.get('proxy'):
            try:
                track_id = player_info.get('track_id', '/')
                player_info['proxy'].SetPosition('(ox)', track_id, int(target_seconds * 1_000_000))
            except Exception as e:
                print("[MPRIS] SetPosition error:", e)

# ─── Floating Detachable Music Island ────────────────────────────────
class FloatingMusicIsland(Gtk.Window):
    def __init__(self, main_notch):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.main_notch = main_notch
        self.set_name("nusa-floating-island")
        self.set_title("Nusa Music Island")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)

        self.W = 340
        self.H = 54
        self.set_default_size(self.W, self.H)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK
        )
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)

        # Positioning: Restore saved position or place at bottom-right
        geom = main_notch.get_monitor_geometry()
        saved_pos = main_notch.settings.get("floating_player_pos")
        if saved_pos and len(saved_pos) == 2:
            self.move(int(saved_pos[0]), int(saved_pos[1]))
        else:
            default_x = geom.x + geom.width - self.W - 35
            default_y = geom.y + geom.height - self.H - 65
            self.move(default_x, default_y)

    def on_button_press(self, widget, event):
        x, y = event.x, event.y

        # 1. Close / Hide Button (Top-Right: X > 316, Y < 24)
        if x >= 316 and y <= 24:
            self.main_notch.settings["floating_player_enabled"] = False
            save_settings(self.main_notch.settings)
            self.hide()
            self.main_notch.queue_draw()
            return True

        # 2. Play / Pause Button (Around X=266, Y=27, r=14)
        if 250 <= x <= 280 and 13 <= y <= 41:
            self.main_notch.mpris.play_pause(self.main_notch.active_player)
            return True

        # 3. Next Button (Around X=296, Y=27, r=12)
        if 284 <= x <= 310 and 15 <= y <= 39:
            self.main_notch.mpris.next(self.main_notch.active_player)
            return True

        # 4. Draggable anywhere else on the pill
        if event.button == 1:
            self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True

        return True

    def on_button_release(self, widget, event):
        pos = self.get_position()
        self.main_notch.settings["floating_player_pos"] = [pos[0], pos[1]]
        save_settings(self.main_notch.settings)
        return False

    def on_draw(self, widget, cr):
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        w, h, r = float(self.W), float(self.H), 27.0
        player = self.main_notch.active_player
        source = self.main_notch.detect_source(player)
        scolor = source['color']
        is_playing = (player and player.get('status') == 'Playing')

        # 1. Floating Pill Capsule Background
        cr.new_path()
        cr.new_sub_path()
        cr.arc(w - r, r, r, -math.pi/2, math.pi/2)
        cr.arc(r, h - r, r, math.pi/2, 3*math.pi/2)
        cr.close_path()

        grad = cairo.LinearGradient(0, 0, 0, h)
        grad.add_color_stop_rgba(0, 0.05, 0.06, 0.10, 0.96)
        grad.add_color_stop_rgba(1, 0.08, 0.09, 0.15, 0.98)
        cr.set_source(grad)
        cr.fill_preserve()

        # Dynamic Ambient Border
        cr.set_source_rgba(scolor[0], scolor[1], scolor[2], 0.70)
        cr.set_line_width(1.4)
        cr.stroke()

        # 2. Left: Logo Badge (34x34 at X=10, Y=10)
        card_x, card_y, card_s, card_r = 10.0, 10.0, 34.0, 9.0
        cr.save()
        cr.new_path()
        cr.new_sub_path()
        cr.arc(card_x + card_s - card_r, card_y + card_r, card_r, -math.pi/2, 0)
        cr.arc(card_x + card_s - card_r, card_y + card_s - card_r, card_r, 0, math.pi/2)
        cr.arc(card_x + card_r, card_y + card_s - card_r, card_r, math.pi/2, math.pi)
        cr.arc(card_x + card_r, card_y + card_r, card_r, math.pi, 3*math.pi/2)
        cr.close_path()
        cr.set_source_rgba(0.12, 0.14, 0.22, 0.92)
        cr.fill_preserve()
        cr.set_source_rgba(scolor[0], scolor[1], scolor[2], 0.4)
        cr.set_line_width(1.1)
        cr.stroke()

        self.main_notch.draw_source_logo(cr, card_x + card_s / 2.0, card_y + card_s / 2.0, card_s, source['type'])
        cr.restore()

        # 3. Middle: Text Info
        layout = PangoCairo.create_layout(cr)
        title = player.get('title') if player else "Tidak ada musik"
        artist = player.get('artist') if player else "Nusa Floating Player"

        if len(title) > 22:
            display_title = title[:20] + ".."
        else:
            display_title = title

        if len(artist) > 26:
            display_artist = artist[:24] + ".."
        else:
            display_artist = artist

        # Title
        font = Pango.FontDescription("Ubuntu, Sans Bold 10")
        layout.set_font_description(font)
        layout.set_text(display_title, -1)
        cr.set_source_rgba(0.95, 0.98, 1.0, 1.0)
        cr.move_to(52, 11)
        PangoCairo.show_layout(cr, layout)

        # Artist
        font = Pango.FontDescription("Ubuntu, Sans 8.5")
        layout.set_font_description(font)
        layout.set_text(display_artist, -1)
        cr.set_source_rgba(0.68, 0.72, 0.85, 0.85)
        cr.move_to(52, 29)
        PangoCairo.show_layout(cr, layout)

        # 4. Animated Candle Suara (Visualizer) at X=230, Y=27
        self.main_notch.draw_visualizer_bars(
            cr, cx=230, cy=27, num_bars=5,
            is_playing=is_playing, color=scolor,
            max_h=20.0, bar_w=2.6, bar_gap=2.2, alpha=1.0
        )

        # 5. Crisp Vector Play / Pause Button at X=266, Y=27 (r=13)
        self.main_notch.draw_vector_play_pause(cr, cx=266, cy=27, r=13, is_playing=is_playing, alpha=1.0)

        # 6. Crisp Vector Next Button at X=296, Y=27 (r=11)
        self.main_notch.draw_vector_next(cr, cx=296, cy=27, r=11, alpha=1.0)

        # 7. Close / Hide Button at X=324, Y=14
        cr.save()
        cr.new_path()
        layout.set_font_description(Pango.FontDescription("Ubuntu, Sans Bold 8"))
        layout.set_text("✕", -1)
        cw, ch = layout.get_pixel_size()
        cr.set_source_rgba(0.65, 0.68, 0.80, 0.75)
        cr.move_to(324 - cw / 2.0, 14 - ch / 2.0)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

        return False

# ─── Main Nusa Living Notch ─────────────────────────────────────────
class NusaNotch(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("nusa-living-notch")
        self.set_title("Nusa")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()

        # Proportions
        self.IDLE_W = 166
        self.IDLE_H = 30
        self.EXP_W = 430
        self.EXP_H = 224

        # Start physically as the exact 166x30 pill
        self.set_default_size(self.IDLE_W, self.IDLE_H)

        # Spring Physics Animation Engine
        self.spring = FluidSpring(stiffness=185.0, damping=14.5)
        self.tick_id = 0
        self.last_tick_us = 0
        self.is_expanded = False

        # Mascot States: AWAKE, BLINK, HAPPY, SLEEPY, SINGING
        self.mascot_state = "AWAKE"
        self.blink_progress = 0.0
        self.is_blinking = False
        self.last_hover_time = time.time()
        self.next_blink_time = time.time() + 4.0
        self.sleepy_z = 0.0

        # Tabs: 0: Music, 1: Focus, 2: Shelf, 3: Water
        self.active_tab = 0
        self.tabs = ["Music", "Focus", "Shelf", "Water"]

        # Controllers & Data
        self.settings = load_settings()
        self.shelf_items = load_shelf()
        self.mpris = MprisController()
        self.active_player = None

        # Pomodoro
        self.pomo_running = False
        self.pomo_time_left = self.settings.get("pomodoro_duration", 25 * 60)

        # Audio Visualizer "Candle Suara"
        self.visualizer_phase = 0.0

        # State flags
        self.drag_hover = False
        self.retract_timer = None
        self.watchdog_id = 0

        # RGBA visual
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_app_paintable(True)

        # Connect GDK events
        self.connect("draw", self.on_draw)
        self.add_events(
            Gdk.EventMask.ENTER_NOTIFY_MASK |
            Gdk.EventMask.LEAVE_NOTIFY_MASK |
            Gdk.EventMask.BUTTON_PRESS_MASK
        )
        self.connect("enter-notify-event", self.on_enter)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("button-press-event", self.on_button_press)

        # Drag & drop setup
        self.drag_dest_set(Gtk.DestDefaults.ALL, [], Gdk.DragAction.COPY | Gdk.DragAction.MOVE)
        self.drag_dest_add_uri_targets()
        self.connect("drag-motion", self.on_drag_motion)
        self.connect("drag-leave", self.on_drag_leave)
        self.connect("drag-data-received", self.on_drag_drop)

        # Floating Mini Player Island
        self.floating_player = FloatingMusicIsland(self)
        if self.settings.get("floating_player_enabled", True):
            self.floating_player.show_all()

        # Background tickers
        GLib.timeout_add(1000, self.on_second_tick)
        GLib.timeout_add(30, self.on_fast_tick)

        self.reposition(self.IDLE_W)
        self.show_all()

    def get_monitor_geometry(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor()
        if not monitor:
            monitor = display.get_monitor(0)
        return monitor.get_geometry()

    def reposition(self, current_width):
        geom = self.get_monitor_geometry()
        x = geom.x + (geom.width - current_width) // 2
        y = geom.y
        self.move(x, y)

    # ─── VSync Frame Animation Engine ───────────────────────────────
    def ensure_animation(self):
        if self.tick_id == 0:
            self.last_tick_us = 0
            self.tick_id = self.add_tick_callback(self.on_frame_tick)

    def on_frame_tick(self, widget, frame_clock):
        now_us = frame_clock.get_frame_time()
        if self.last_tick_us == 0:
            dt = 0.016
        else:
            dt = min(0.04, max(0.005, (now_us - self.last_tick_us) / 1000000.0))
        self.last_tick_us = now_us

        settled = self.spring.update(dt)
        self.queue_draw()

        if settled:
            self.tick_id = 0
            if not self.is_expanded:
                # Physically snap window back to 166x30 pill
                self.resize(self.IDLE_W, self.IDLE_H)
                self.reposition(self.IDLE_W)
            return False
        return True

    def expand(self):
        self.cancel_retract()
        if self.is_expanded:
            return
        self.is_expanded = True
        self.mascot_state = "HAPPY"

        # Resize window to full canvas
        self.resize(self.EXP_W, self.EXP_H)
        self.reposition(self.EXP_W)

        # Trigger spring expansion
        self.spring.set_target(1.0)
        self.ensure_animation()

        # Start pointer watchdog to guarantee auto-close
        if self.watchdog_id == 0:
            self.watchdog_id = GLib.timeout_add(150, self.check_pointer_watchdog)

    def retract(self):
        self.cancel_retract()
        if not self.is_expanded:
            return
        self.is_expanded = False
        self.drag_hover = False
        self.mascot_state = "AWAKE"

        if self.watchdog_id != 0:
            GLib.source_remove(self.watchdog_id)
            self.watchdog_id = 0

        # Trigger spring retraction
        self.spring.set_target(0.0)
        self.ensure_animation()

    def cancel_retract(self):
        if self.retract_timer:
            GLib.source_remove(self.retract_timer)
            self.retract_timer = None

    def check_pointer_watchdog(self):
        if not self.is_expanded:
            self.watchdog_id = 0
            return False

        display = Gdk.Display.get_default()
        if not display:
            return True
        seat = display.get_default_seat()
        if not seat:
            return True
        pointer = seat.get_pointer()
        if not pointer:
            return True

        _, px, py = pointer.get_position()
        win_x, win_y = self.get_position()
        alloc = self.get_allocation()

        # Is physical cursor within the expanded window?
        inside = (win_x <= px <= win_x + alloc.width and win_y <= py <= win_y + alloc.height)

        if not inside:
            if not self.retract_timer:
                self.retract_timer = GLib.timeout_add(250, self._do_retract)
        else:
            self.cancel_retract()

        return True

    # ─── Mouse Event Handling ───────────────────────────────────────
    def on_enter(self, widget, event):
        self.last_hover_time = time.time()
        self.expand()
        return True

    def on_leave(self, widget, event):
        alloc = self.get_allocation()
        if 0 <= event.x <= alloc.width and 0 <= event.y <= alloc.height:
            return False

        self.last_hover_time = time.time()
        if not self.retract_timer:
            self.retract_timer = GLib.timeout_add(250, self._do_retract)
        return True

    def _do_retract(self):
        self.retract()
        self.retract_timer = None
        return False

    # ─── Drag & Drop ────────────────────────────────────────────────
    def on_drag_motion(self, widget, context, x, y, time_val):
        self.cancel_retract()
        if not self.is_expanded:
            self.drag_hover = True
            self.active_tab = 2 # File Shelf
            self.expand()
        Gdk.drag_status(context, Gdk.DragAction.COPY, time_val)
        return True

    def on_drag_leave(self, widget, context, time_val):
        if self.drag_hover:
            self.cancel_retract()
            self.retract_timer = GLib.timeout_add(450, self._do_retract)

    def on_drag_drop(self, widget, context, x, y, data, info, time_val):
        uris = data.get_uris()
        context.finish(True, False, time_val)
        if uris:
            for u in uris:
                if u.startswith("file://"):
                    p = urllib.parse.unquote(urllib.parse.urlparse(u).path)
                    if os.path.exists(p):
                        if not any(item['path'] == p for item in self.shelf_items):
                            name = os.path.basename(p)
                            size_str = self.format_size(os.path.getsize(p)) if not os.path.isdir(p) else "Folder"
                            self.shelf_items.append({
                                "name": name,
                                "path": p,
                                "size": size_str,
                                "is_dir": os.path.isdir(p)
                            })
            save_shelf(self.shelf_items)
            self.active_tab = 2
            self.queue_draw()
            subprocess.Popen(
                ["notify-send", "-a", "Nusa", "Nusa File Shelf", f"Menyimpan {len(uris)} file ke shelf."],
                env=dict(os.environ, DISPLAY=":0", XAUTHORITY=os.path.expanduser("~/.Xauthority"))
            )

    def format_size(self, size_bytes):
        if size_bytes < 1024:
            return f"{size_bytes} B"
        elif size_bytes < 1024 * 1024:
            return f"{size_bytes / 1024:.1f} KB"
        else:
            return f"{size_bytes / (1024 * 1024):.1f} MB"

    # ─── Periodic Tickers ───────────────────────────────────────────
    def on_second_tick(self):
        self.active_player = self.mpris.get_active_player()

        if self.pomo_running and self.pomo_time_left > 0:
            self.pomo_time_left -= 1
            if self.pomo_time_left == 0:
                self.pomo_running = False
                subprocess.Popen(
                    ["notify-send", "-a", "Nusa", "Nusa Focus Time", "Waktu fokus selesai! Istirahat sejenak ☕"],
                    env=dict(os.environ, DISPLAY=":0", XAUTHORITY=os.path.expanduser("~/.Xauthority"))
                )

        now = time.time()
        if not self.is_expanded and (now - self.last_hover_time > 20.0):
            self.mascot_state = "SLEEPY"
        elif not self.is_expanded and self.mascot_state == "SLEEPY":
            self.mascot_state = "AWAKE"

        self.queue_draw()
        if self.floating_player and self.floating_player.get_visible():
            self.floating_player.queue_draw()
        return True

    def on_fast_tick(self):
        now = time.time()

        # Animate Audio Visualizer Candle when playing
        is_playing = (self.active_player and self.active_player.get('status') == 'Playing')
        if is_playing:
            self.visualizer_phase = (self.visualizer_phase + 0.18) % (math.pi * 20.0)
            self.queue_draw()
            if self.floating_player and self.floating_player.get_visible():
                self.floating_player.queue_draw()

        if self.mascot_state == "AWAKE":
            if not self.is_blinking and now >= self.next_blink_time:
                self.is_blinking = True
                self.blink_start = now
            if self.is_blinking:
                dt = now - self.blink_start
                if dt < 0.12:
                    self.blink_progress = dt / 0.12
                elif dt < 0.24:
                    self.blink_progress = 1.0 - (dt - 0.12) / 0.12
                else:
                    self.is_blinking = False
                    self.blink_progress = 0.0
                    self.next_blink_time = now + 3.0 + (hash(str(now)) % 30) / 10.0
                self.queue_draw()

        elif self.mascot_state == "SLEEPY":
            self.sleepy_z = (self.sleepy_z + 0.07) % 6.0
            self.queue_draw()

        return True

    # ─── Source App Detection & Logo Rendering ──────────────────────
    def detect_source(self, player_info):
        if not player_info:
            return {'type': 'music', 'label': 'MUSIC', 'color': [0.55, 0.50, 0.95]}
        name = (player_info.get('name') or '').lower()
        title = (player_info.get('title') or '').lower()
        artist = (player_info.get('artist') or '').lower()
        url = (player_info.get('url') or '').lower()

        if 'spotify' in name or 'spotify' in url:
            return {'type': 'spotify', 'label': 'SPOTIFY', 'color': [0.11, 0.73, 0.33]} # #1DB954
        elif 'youtube' in url or 'youtube' in title or 'chromium' in name or 'chrome' in name or 'brave' in name or 'edge' in name:
            return {'type': 'youtube', 'label': 'YOUTUBE', 'color': [0.95, 0.20, 0.20]} # #FF0000
        elif 'vlc' in name:
            return {'type': 'vlc', 'label': 'VLC', 'color': [1.0, 0.55, 0.0]}
        elif 'firefox' in name:
            return {'type': 'firefox', 'label': 'FIREFOX', 'color': [1.0, 0.40, 0.15]}
        else:
            return {'type': 'local', 'label': 'LOCAL PLAYER', 'color': [0.55, 0.50, 0.95]}

