    def draw_visualizer_bars(self, cr, cx, cy, num_bars, is_playing, color, max_h=24.0, bar_w=3.2, bar_gap=2.5, alpha=1.0):
        cr.save()
        cr.translate(cx, cy)
        total_w = num_bars * bar_w + (num_bars - 1) * bar_gap
        start_x = -total_w / 2.0

        for i in range(num_bars):
            if is_playing:
                phase = self.visualizer_phase + i * 1.35
                h_norm = 0.45 * math.sin(phase) + 0.30 * math.sin(phase * 1.7 + 0.5) + 0.55
                bh = 5.0 + (max_h - 5.0) * max(0.0, min(1.0, h_norm))
            else:
                bh = 3.5

            bx = start_x + i * (bar_w + bar_gap)
            by = -bh / 2.0
            r = bar_w / 2.0

            cr.new_path()
            cr.new_sub_path()
            cr.arc(bx + r, by + r, r, math.pi, 0)
            cr.arc(bx + r, by + bh - r, r, 0, math.pi)
            cr.close_path()

            cr.set_source_rgba(color[0], color[1], color[2], alpha * 0.95)
            cr.fill()

        cr.restore()

